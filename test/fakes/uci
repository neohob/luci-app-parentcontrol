#!/usr/bin/env python3
"""极简 uci 模拟器（白盒测试用）。

状态 = $FAKE_UCI_FILE，JSON：{"parentcontrol.@weburl[0].enable": "1", ...}
节本身也存一条：{"parentcontrol.@weburl[0]": "weburl"}（值=节类型）。

支持 init.d 与迁移逻辑用到的子集：-q / get / show / set key=value / add /
delete / commit / batch（吞掉 stdin）。
"""
import json
import os
import sys

FILE = os.environ.get("FAKE_UCI_FILE", "/tmp/fake-uci.json")


def load():
    try:
        with open(FILE) as fh:
            return json.load(fh)
    except (FileNotFoundError, ValueError):
        return {}


def save(d):
    parent = os.path.dirname(FILE)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(FILE, "w") as fh:
        json.dump(d, fh, ensure_ascii=False)


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "-q":
        argv = argv[1:]
    if not argv:
        return 1
    cmd, rest = argv[0], argv[1:]
    d = load()

    if cmd == "get":
        if not rest:
            return 1
        if rest[0] in d:
            print(d[rest[0]])
            return 0
        return 1

    if cmd == "show":
        prefix = rest[0] if rest else None
        for k, v in d.items():
            if prefix and not k.startswith(prefix + "."):
                continue
            print("%s='%s'" % (k, v))
        return 0

    if cmd == "set":
        for kv in rest:
            if "=" in kv:
                k, v = kv.split("=", 1)
                d[k] = v
        save(d)
        return 0

    if cmd == "add":
        cfg, typ = rest[0], rest[1]
        name = rest[2] if len(rest) > 2 else None
        if not name:
            idx = 0
            while "%s.@%s[%d]" % (cfg, typ, idx) in d:
                idx += 1
            name = "@%s[%d]" % (typ, idx)
        d["%s.%s" % (cfg, name)] = typ
        save(d)
        print(name)
        return 0

    if cmd == "delete":
        for k in rest:
            for kk in [x for x in d if x == k or x.startswith(k + ".")]:
                del d[kk]
        save(d)
        return 0

    if cmd == "commit":
        return 0

    if cmd == "batch":
        sys.stdin.read()
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
