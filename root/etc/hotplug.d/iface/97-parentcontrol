#!/bin/sh
CONFIG=parentcontrol

# [改] 原版这一行是 [ "$(`uci -q get $CONFIG.@basic[0].enabled`)" == 1 ] ——
# `$( ... )` 里又套了反引号，外层会把内层命令的**输出**（也就是 "1"）当成命令去执行，
# 报 "1: not found"，条件恒为假，脚本直接 exit 0。
# 后果：接口事件（含 fw4 重载）后插件从来不会重装规则，规则只在手动点应用时才生效。
[ "$(uci -q get $CONFIG.@basic[0].enabled)" = "1" ] || exit 0

[ "$ACTION" = ifup -o "$ACTION" = ifupdate ] || exit 0
# [改] 原版这里调 `start`（全量重建：del_rule 拆光三链 → refresh_ips → build_all），
# 真机实测 09:02:21 restored → 09:02:47 disabled = 26 秒封锁/计数空窗，且每次都白杀一遍
# 连接。接口事件（ifupdate 在 DHCP 续租/邻居变化/fw4 重载时反复触发）的真实需求只有
# 「fw4 重载可能清空了我们的 mangle 链，补齐」——所以改调 `ensure`（design D7）：
# hooks 齐备时只跑 build_quota_blocks + sync_offload，不拆链、不 purge、不 refresh_ips。
/etc/init.d/parentcontrol ensure
