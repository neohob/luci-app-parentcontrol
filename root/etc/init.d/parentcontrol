#!/bin/sh /etc/rc.common
# 本插件新增：每日额度 / 平日-节假日双档案 / 共享额度池 / 节假日数据
# 设计说明见 README；纯逻辑（日子判定、额度、用量）在 /usr/lib/parentcontrol/common.sh

DIR="$(cd "$(dirname "$0")" && pwd)"
START=98

# “今天 / 重置点 / 额度”一律按北京时间（UTC+8）计算，与路由器系统时区无关。
# 用 POSIX TZ 字串，不依赖 zoneinfo 文件。
TZ=UTC-8
export TZ

PC_CONF=parentcontrol
CONFIG=$PC_CONF
LOG_FILE=${LOG_FILE:-/tmp/log/$CONFIG.log}
LOCK=${LOCK:-/tmp/lock/${CONFIG}.lock}
TICK_LOCK=${TICK_LOCK:-/tmp/lock/${CONFIG}.tick}
ipt=$(command -v iptables-legacy || command -v iptables)
ipt6=$(command -v ip6tables-legacy || command -v ip6tables)

# 统一后只剩三条链（都在 mangle PREROUTING，顺序 TAGQ → TAGA → TAGD）：
#   TAGQ 额度/时段封锁、TAGA 用量计数、TAGD 诊断明细（只计数、不改道）。
#   老版本的 PARENTCONTROL_TIME/PROTOCOL/WEBURL/IP
#   已废弃，只在 del_rule 里按字面量清理一次。
TAGA="PARENTCONTROL_ACCT"
TAGQ="PARENTCONTROL_QUOTA"
TAGD="PARENTCONTROL_DIAG"
# 诊断明细的客户端上限（D19/A27）：每条目最多给这么多台「未覆盖客户端」装计数规则。
PC_DIAG_MAX=${PC_DIAG_MAX:-8}
FWI="/var/etc/$CONFIG.include"
IPDIR=${IPDIR:-/etc/parentcontrol/ips}
USAGE_DIR=${USAGE_DIR:-/etc/parentcontrol/usage}
HOLIDAY_CACHE=${HOLIDAY_CACHE:-/etc/parentcontrol/holiday}
HOLIDAY_LOCAL=${HOLIDAY_LOCAL:-/usr/share/parentcontrol/holiday}
STATE_DIR=${STATE_DIR:-/tmp/parentcontrol}
# 重置日志放 /etc（flash）是有意的：重置历史要跨重启保留，不能放 /tmp。
RESET_LOG=${RESET_LOG:-/etc/parentcontrol/resets.log}
# DHCP 租约（dnsmasq 格式）——hosts_tsv 用它补 IP/主机名；可覆盖以便白盒测试指到临时文件。
DHCP_LEASES=${DHCP_LEASES:-/tmp/dhcp.leases}
TAB=$(printf '\t')   # 诊断文件的字段分隔符（c 行含主机名，不能用空格）
CRON_TAG="#pc_tick"
CRON_TAG_IP="#pc_ip_refresh"

. "${PC_LIB:-/usr/lib/parentcontrol/common.sh}"

EXTRA_COMMANDS="tick refresh_ip refresh_holiday stats_tsv reset_quota ai_http hosts_tsv ensure"
EXTRA_HELP="
	tick             Re-evaluate quota state and account usage (cron, every minute)
	refresh_ip       Re-resolve domains and rebuild IP rules (cron)
	refresh_holiday  Fetch statutory-holiday data for this year and next
	stats_tsv [brief]  Print dashboard/list data as TSV (brief: meta+entry only)
	stats_tsv        Print full stats for the dashboard as TSV
	reset_quota      Reset an entry's (or pool's) quota for today; logged to /etc/parentcontrol/resets.log
	ai_http          GET/POST a URL via curl/uclient-fetch/wget (used by the AI domain helper)
	hosts_tsv        Print LAN hosts as 'host <mac> <ip> <name> <online>' (binding health / diagnostics)
	ensure           Lightweight repair: rebuild quota blocks + offload state only (hotplug iface events)"

elog() {
	echo "$(date '+%Y-%m-%d %H:%M:%S'): $*" >>$LOG_FILE
}

clean_log() {
	[ "$(cat $LOG_FILE 2>/dev/null | wc -l)" -gt 500 ] && : > "$LOG_FILE"
}

# ============================================================================
# 小工具
# ============================================================================
# 规则下发的唯一出口（$1=ipcmd，其余原样照传）。
# PC_RENDER 指向文件时只把“本次会下发什么”记进文件、不碰内核 —— 供
# build_quota_blocks 判断规则集有没有变（见那里的说明）。
ipt_do() {
	if [ -n "$PC_RENDER" ]; then
		case "$1" in
		"$ipt6") printf 'v6|%s\n' "$*" >> "$PC_RENDER" ;;
		*)       printf 'v4|%s\n' "$*" >> "$PC_RENDER" ;;
		esac
		return 0
	fi
	"$@" 2>/dev/null
	return 0
}

ensure_chain() { # $1=ipcmd $2=table $3=chain
	$1 -t $2 -N $3 2>/dev/null || $1 -t $2 -F $3 2>/dev/null
}
hook_chain() { # $1=ipcmd $2=table $3=parent $4=chain
	$1 -t $2 -C $3 -j $4 2>/dev/null || $1 -t $2 -I $3 -j $4 2>/dev/null
}
entry_key() { echo "$1_$2"; }

# 地址是否属于某协议族（$2=1 → IPv6 族）
addr_is_family() {
	case "$1" in
	*:*) [ "$2" = 1 ] ;;
	*)   [ "$2" = 0 ] ;;
	esac
}

# 计数用的“设备条件”：逐行遍历 clients（A90/A88）。每行：
#   ip 属于本族 → `-s <ip>`；否则有 mac → `-m mac --mac-source <mac>`；两者都不可用则跳过该行。
# 无任何 clients 行 ⇒ 输出 ALL（条目没有任何设备条件 = 对全部客户端计数）。
# 输出：每行一个条件串 / ALL / 空（本族无法识别任何行）
devcount() { # $1=ipcmd $2=module $3=idx
	local _fam6 _rows _row _m _ip
	_fam6=0
	[ "$1" = "$ipt6" ] && _fam6=1
	_rows=$(pc_clients_rows "$2" "$3")
	[ -z "$_rows" ] && { echo "ALL"; return 0; }
	for _row in $_rows; do
		case "$_row" in
		*"|"*) _m=${_row%%|*}; _ip=${_row#*|} ;;
		*)     _m=$_row; _ip="" ;;
		esac
		if [ -n "$_ip" ] && addr_is_family "$_ip" "$_fam6"; then echo "-s $_ip"
		elif [ -n "$_m" ]; then echo "-m mac --mac-source $_m"
		fi
	done
}

# 封锁/时段用：对条目的每台设备各加规则（mac 与 ip 任一命中即生效）；
# 逐行遍历 clients（A90）：每行 mac 一条、ip（同族）一条；只有「无任何行」才退化成对全部客户端。
add_dev_rules() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action
	local _rows _row _m _ip _n _fam6
	_fam6=0
	[ "$1" = "$ipt6" ] && _fam6=1
	_rows=$(pc_clients_rows "$4" "$5")
	_n=0
	for _row in $_rows; do
		case "$_row" in
		*"|"*) _m=${_row%%|*}; _ip=${_row#*|} ;;
		*)     _m=$_row; _ip="" ;;
		esac
		[ -n "$_m" ] && { ipt_do "$1" -t "$2" -I "$3" -m mac --mac-source "$_m" $6 $7; _n=1; }
		# 静态 IP 只对同族链有意义（往 ip6tables 里塞 IPv4 地址只会静默失败）
		[ -n "$_ip" ] && addr_is_family "$_ip" "$_fam6" && { ipt_do "$1" -t "$2" -I "$3" -s "$_ip" $6 $7; _n=1; }
	done
	# 只有「条目本身没有任何设备条件」才退化成对全部客户端 —— 否则会变成无条件 DROP
	if [ "$_n" = 0 ] && [ -z "$_rows" ]; then
		ipt_do "$1" -t "$2" -I "$3" $6 $7
	fi
	return 0
}

# 时段窗口（禁止时段）。起控=停控 或留空 → 无时间条件（= 全天封，沿用旧语义）

# 协议端口条件（单个用 --sport/--dport；多个/范围用 -m multiport）
proto_cond() { # $1=idx
	local _proto _ports _portd _cond
	_proto=$(pc_uget "@protocol[$1].proto"); [ -z "$_proto" ] && _proto=tcp
	_ports=$(pc_uget "@protocol[$1].ports")
	_portd=$(pc_uget "@protocol[$1].portd")
	_cond="-p $_proto"
	if [ -n "$_ports" ] && [ -n "$_portd" ]; then
		_cond="$_cond -m multiport --sports $_ports --dports $_portd"
	elif [ -n "$_portd" ]; then
		case "$_portd" in *,*|*:*) _cond="$_cond -m multiport --dports $_portd" ;; *) _cond="$_cond --dport $_portd" ;; esac
	elif [ -n "$_ports" ]; then
		case "$_ports" in *,*|*:*) _cond="$_cond -m multiport --sports $_ports" ;; *) _cond="$_cond --sport $_ports" ;; esac
	fi
	echo "$_cond"
}

# ============================================================================
# 域名解析 → 按条目存 IP 列表（IPv4 /24 或 /32，IPv6 /64，含 / 的按 CIDR 原样）
# ============================================================================
ip6_slash64() {
	echo "$1" | awk -F"::" '
		{
			if (NF == 2) {
				na = ($1 == "") ? 0 : split($1, a, ":")
				nb = ($2 == "") ? 0 : split($2, b, ":")
				n = 8 - na - nb
				out = $1
				for (i = 0; i < n; i++) out = out ":0"
				out = out ":" $2
			} else { out = $1 }
			sub(/^:/, "", out); sub(/:$/, "", out)
			split(out, p, ":")
			printf "%s:%s:%s:%s::/64\n", p[1], p[2], p[3], p[4]
		}'
}

# 条目的目标枚举源（第 8 轮 D14/ADR-018）：优先 apps 行表（各行 `|` 右侧的域名并集，
# 去重、空格分隔），无 apps 时回退 domains，再回退老 word。解析只走 common.sh 的
# pc_apps_rows（唯一实现），这里不再自己拆行。
entry_domains() { # $1=module $2=idx
	local _a _d
	_a=$(pc_uget "@$1[$2].apps")
	if [ -n "$_a" ]; then
		pc_apps_rows "$_a" | awk -F'\t' '
			{
				n = split($2, w, / +/)
				for (i = 1; i <= n; i++)
					if (w[i] != "" && !seen[w[i]]++) out = (out == "") ? w[i] : out " " w[i]
			}
			END { print out }'
		return 0
	fi
	_d=$(pc_uget "@$1[$2].domains")
	[ -z "$_d" ] && _d=$(pc_uget "@$1[$2].word")
	echo "$_d" | tr ',' ' '
}

resolve_host() { # $1=host → 打印 IPv4(/24 或 /32) 与 IPv6(/64)
	local _a
	for _a in $(resolveip -4 -t 2 "$1" 2>/dev/null); do
		echo "$_a" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || continue
		if [ "$PC_IPMASK" = "32" ]; then echo "$_a"; else echo "$(echo $_a | cut -d. -f1-3).0/24"; fi
	done
	for _a in $(resolveip -6 -t 2 "$1" 2>/dev/null); do
		echo "$_a" | grep -qE '^[0-9a-fA-F:]+$' || continue
		case "$_a" in *:*) ip6_slash64 "$_a" ;; esac
	done
}

resolve_entry() { # $1=module $2=idx
	local _h _hh
	for _h in $(entry_domains "$1" "$2"); do
		case "$_h" in
		*/*) echo "$_h" ;;   # 直接写 CIDR：不解析，原样使用
		*.*)
			resolve_host "$_h"
			case "$_h" in
			www.*) resolve_host "${_h#www.}" ;;
			*)     resolve_host "www.$_h" ;;
			esac ;;
		*)
			for _hh in "$_h" "$_h.com" "www.$_h.com" "$_h.cn"; do resolve_host "$_hh"; done ;;
		esac
	done
}

refresh_ips() {
	local _i _f _idx
	mkdir -p "$IPDIR"
	command -v resolveip >/dev/null 2>&1 || return 0
	PC_IPMASK=$(pc_uget "@basic[0].ip_mask"); [ -z "$PC_IPMASK" ] && PC_IPMASK=24
	for _i in $(pc_ids_on weburl); do
		_f="$IPDIR/weburl_$_i"
		{ resolve_entry weburl $_i; [ -f "$_f" ] && cat "$_f"; } 2>/dev/null \
			| grep -v '^$' | sort -u > "$_f.new"
		mv "$_f.new" "$_f"
	done
	for _f in "$IPDIR"/weburl_*; do
		[ -e "$_f" ] || continue
		_idx=${_f##*weburl_}
		pc_ids_on weburl | grep -qx "$_idx" || rm -f "$_f"
	done
	elog "refresh_ips: $(cat "$IPDIR"/* 2>/dev/null | wc -l) 条目标 IP"
}

# ============================================================================
# 节假日数据
# ============================================================================
fetch_url() { # $1=url $2=out —— 唯一实现在 common.sh 的 pc_http（D9：curl→uclient-fetch→wget 单一阶梯）
	pc_http GET "$1" "$2"
}

refresh_holiday() { # [$1=force|novet]
	local _b _n _y _y2 _yy _f _stamp _u
	mkdir -p "$HOLIDAY_CACHE"
	for _b in "$HOLIDAY_LOCAL"/*.json; do
		[ -e "$_b" ] || continue
		_n="$HOLIDAY_CACHE/$(basename "$_b")"
		[ -f "$_n" ] || cp "$_b" "$_n"
	done
	# novet：只复制离线 bundle，不联网（用于开机，避免启动卡在网络上）
	[ "$1" = "novet" ] && return 0
	_y=$(date +%Y); _y2=$((_y + 1))
	for _yy in $_y $_y2; do
		_f="$HOLIDAY_CACHE/$_yy.json"
		_stamp="$HOLIDAY_CACHE/$_yy.stamp"
		if [ "$1" != "force" ]; then
			# 一天内不再重试，避免对着未发布的明年数据反复请求
			[ -f "$_stamp" ] && [ -z "$(find "$_stamp" -mmin +1440 2>/dev/null)" ] && continue
			# 已有 7 天内的有效数据
			[ -f "$_f" ] && grep -q '"date"' "$_f" 2>/dev/null && [ -z "$(find "$_f" -mtime +7 2>/dev/null)" ] && continue
		fi
		for _u in \
			"https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/$_yy.json" \
			"https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/$_yy.json"; do
			if fetch_url "$_u" "$_f.tmp" && grep -q '"date"' "$_f.tmp" 2>/dev/null; then
				mv "$_f.tmp" "$_f"
				elog "holiday: fetched $_yy"
				break
			fi
			rm -f "$_f.tmp"
		done
		touch "$_stamp" 2>/dev/null
	done
}

# ============================================================================
# flow-offload（沿用旧逻辑：有受管设备就不让任何流被卸载）
# ============================================================================
offload_macs() {
	pc_uget "@basic[0].enabled" | grep -q '^1$' || return 0
	weburl_macs_all
}
# 注意：不能用 `grep 'weburl'` 找 —— 命名节的行是 `parentcontrol.kids.mac='…'`，
# 整行不含 "weburl"，会被漏掉（同一类 F5 缺陷）。改按「节类型」判定。
# 全部**已启用**条目绑定的 MAC 并集（A96/A5）：任一 PC_MODULES 的任一启用节的 clients 中的 MAC。
# 不按节类型过滤（time/protocol 条目也可能绑定设备），但**必须**看 enable：
# 停用条目（enable='0'）的设备既不该被禁卸载，也不该进 conntrack purge 名单
# （RC-2：旧版用 pc_ids_all 让 weburl_1/weburl_2 这类停用条目也进了杀伤名单）。
weburl_macs_all() {
	local _m _i
	for _m in $PC_MODULES; do
		for _i in $(pc_ids_on "$_m"); do
			pc_clients_macs "$_m" "$_i"
		done
	done | sort -u
}
# 同上，取 IP 并集（同样只看启用节）
weburl_ips_all() {
	local _m _i
	for _m in $PC_MODULES; do
		for _i in $(pc_ids_on "$_m"); do
			pc_clients_ips "$_m" "$_i"
		done
	done | sort -u
}
offload_handle() {
	nft -a list chain inet fw4 forward 2>/dev/null \
		| grep 'flow add @ft' | head -1 \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}
# 生效状态签名（design §5.1）：两段纯文本，段间以 `#keys` 分隔。
#   #hosts 段 = 受管**设备** MAC ∪ 受管**设备** IP（来自 pc_clients_ips，排序去重）
#               ——「受管对象集合」（A19/I1：是**源**地址，不是 weburl 目标 IP）
#   #keys  段 = 每条启用条目一行 `key|reason`（原始遍历顺序，不排序，保证可比）
# 关键设计（D2/A3）：签名**不含** weburl 目标 IP 的具体地址，所以 refresh_ip 把
# 名单从 43 条刷到 45 条**不会**触发 purge —— 那正是用户报的「视频看一半重新 loading」。
# #hosts 段的作用只是「新增受管对象时杀掉它已有的连接」（conntrack 已建立的流不受新
# DROP 规则影响，不杀就封不住）。
offload_sig_build() {
	local _c
	printf '#hosts\n'
	{ offload_macs; weburl_ips_all; } | grep -v '^$' | sort -u
	printf '#keys\n'
	# A14/M1：读私有草稿（${PC_SIG_CUR}，由 build_quota_blocks 赋值并带 $$）。
	# 兜底旧固定路径只为兼容「build_quota_blocks 未被调用」的直接调用场景。
	_c=${PC_SIG_CUR:-$STATE_DIR/offloadsig.cur}
	[ -f "$_c" ] && cat "$_c"
	return 0
}

# 两次签名的差异 → 逗号分隔的 purge 原因（design §5.2）。
#   init          旧签名不存在/为空/无 #keys 段（D8 fail-safe：宁可多杀不可漏杀）
#   device        #hosts 段变了（新增受管设备/条目）
#   <r>:<key>     某条目的封锁状态从别的值变成 r（r ∈ quota/window/white_all）
#   unlock:<key>  某条目从封锁态回到 none（解锁 —— 与 init 区分，A18/L2）
# 输出永不为空（变化了但说不出具体原因时兜底 init），保证日志里一定有 reason=。
offload_sig_reason() { # $1=旧签名 $2=新签名
	local _d _r
	_d="$STATE_DIR/sigcmp.$$"
	mkdir -p "$_d"
	printf '%s\n' "$1" > "$_d/old"
	printf '%s\n' "$2" > "$_d/new"
	_r=$(awk '
		FNR == 1   { sect = "h" }
		/^#hosts$/ { sect = "h"; next }
		/^#keys$/  { sect = "k"; next }
		$0 == ""   { next }
		FILENAME == ARGV[1] {
			if (sect == "k") { split($0, a, "|"); ov[a[1]] = a[2]; on++ }
			else ohs = ohs "\n" $0
			next
		}
		{
			if (sect == "k") { split($0, a, "|"); nv[a[1]] = a[2]; nk[++nn] = a[1] }
			else nhs = nhs "\n" $0
		}
		END {
			if (ohs == "" && on == 0) { print "init"; exit }
			r = ""
			if (ohs != nhs) r = "device"
			# 解锁（→ none）单独点名 unlock:<key>，与 init（首次构建/无法归因）区分
			# （A18/L2）。多个条目同时解锁 ⇒ 按 key 升序（busybox awk 无 asort，
			# 用插入排序），保证日志顺序稳定可断言。
			nu = 0
			for (i = 1; i <= nn; i++) {
				k = nk[i]; v = nv[k]
				if (v == "none" && ov[k] != "" && ov[k] != "none") uk[++nu] = k
			}
			for (i = 2; i <= nu; i++) {
				t = uk[i]
				for (j = i - 1; j >= 1 && uk[j] > t; j--) uk[j + 1] = uk[j]
				uk[j + 1] = t
			}
			for (i = 1; i <= nu; i++)
				r = (r == "") ? "unlock:" uk[i] : r ",unlock:" uk[i]
			# 进入封锁态（plan 步骤 4.4：新 reason ≠ none）。
			for (i = 1; i <= nn; i++) {
				k = nk[i]; v = nv[k]
				if (v != "" && v != "none" && v != ov[k])
					r = (r == "") ? v ":" k : r "," v ":" k
			}
			if (r == "") r = "init"
			print r
		}' "$_d/old" "$_d/new")
	rm -rf "$_d"
	[ -n "$_r" ] || _r=init
	echo "$_r"
}

# sync_offload（A1/D1）：原「应用 offload」函数的继任者。**杀伤性动作只有一个 —— conntrack -D**，
# 它现在被「生效状态签名」门控：签名与上次一致 ⇒ 一条连接都不杀、一行日志都不写（A7）。
# nft flow add 的删/恢复只在**真发生切换**时执行，且单次构建最多各一次（A6）。
sync_offload() {
	local h n m a _hosts _new _old _rsn _hn
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	_hosts=$({ offload_macs; weburl_ips_all; } | grep -v '^$' | sort -u)
	if [ -z "$_hosts" ]; then
		# 无受管设备（含「全部条目停用」）：不杀连接，恢复全局 offload（A11/D5）。
		# 签名一律删掉：否则「先全停再全启」会被判为签名未变而不 purge，
		# 刚启用的封锁对已建立流不生效。
		if ! nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
			nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
			if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
				elog "offload: restored"
			else
				elog "offload: ERROR 恢复 flow add 规则失败"
			fi
		fi
		rm -f "$STATE_DIR/offloadsig" "$PC_SIG_CUR" "$STATE_DIR/offloadsig.cur"
		printf 'on\n' > /tmp/pc_offload_state
		return 0
	fi
	# 有受管设备：确保全局 offload 是关的（真切换才写日志）
	if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
		h=$(offload_handle)
		[ -n "$h" ] && nft delete rule inet fw4 forward handle $h 2>/dev/null
		if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
			elog "offload: ERROR 删除 flow add 规则失败"
		else
			elog "offload: disabled"
		fi
	fi
	# 签名门控（A1）：状态没变就到此为止 —— 不 purge、不写日志。
	_new=$(offload_sig_build)
	_old=$(cat "$STATE_DIR/offloadsig" 2>/dev/null)
	if [ "$_new" != "$_old" ]; then
		_rsn=$(offload_sig_reason "$_old" "$_new")
		n=0
		if command -v conntrack >/dev/null 2>&1; then
			for m in $(offload_macs); do
				for a in $(ip neigh show 2>/dev/null | grep -i " $m " | awk '{print $1}'); do
					conntrack -D -s "$a" >/dev/null 2>&1 && n=$((n + 1))
				done
			done
			for a in $(weburl_ips_all); do
				conntrack -D -s "$a" >/dev/null 2>&1 && n=$((n + 1))
			done
		fi
		# 签名先落盘（即使一个 -D 都没成功），否则下一 tick 会重复同一原因
		mkdir -p "$STATE_DIR"
		# A17/L1：原子落盘 —— 中断时旧签名原地不动（下轮判 mismatch 多杀一次，fail-safe 方向）
		printf '%s' "$_new" > "$STATE_DIR/offloadsig.tmp.$$" &&
			mv -f "$STATE_DIR/offloadsig.tmp.$$" "$STATE_DIR/offloadsig"
		_hn=$(printf '%s\n' "$_hosts" | grep -c .)
		[ "$n" -gt 0 ] && elog "offload: purged conntrack reason=$_rsn hosts=$_hn"
	fi
	rm -f "$PC_SIG_CUR" "$STATE_DIR/offloadsig.cur"
	printf 'disabled\n' > /tmp/pc_offload_state
	return 0
}

restore_offload() {
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	# A7：只在真发生切换时才打日志（stop 反复调用不该刷屏）
	if ! nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
		nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
		if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
			elog "offload: restored"
		fi
	fi
	printf 'on\n' > /tmp/pc_offload_state
	return 0
}

# ============================================================================
# 规则构建
# ============================================================================

# 在链顶插入「目标为局域网网段 → 直接放行」。路由器自身的管理地址就在局域网网段里，
# 所以这是防自锁的关键：无设备条件的条目（= 对全部客户端生效）一旦生成无条件
# DROP/REJECT，没有这条就会被管理员自己也一起封掉（实测踩过）。
# 注意必须在所有封锁规则插完之后再调用——-I 是插到链首。
# 本机没有 addrtype 模块，只能用「目标网段」放行，等价于放行到路由器自身的管理流量。
allow_lan_in() { # $1=ipcmd $2=table $3=chain
	local _nets _n
	if [ "$1" = "$ipt6" ]; then
		# v6：家里 on-link 前缀只能问内核路由表（GUA/ULA 都不在 UCI 里，F3 ADR-2）
		_nets=$(pc_lan_nets6)
	else
		# v4：语义冻结（F3 ADR-5），仍走 uci 静态节，一字不改
		# 但保留改动前的族语义：跳过含 ":" 的值（等价于原 addr_is_family "$_n" 0）——
		# 静态节里含冒号的 ipaddr 透传进 iptables 是非法规则，且渲染指纹会与实际
		# 规则永久不一致 → 每分钟无谓全量重建（F3 阶段 5 SF-2）。
		_nets=$(pc_lan_nets | grep -v ':')
	fi
	for _n in $_nets; do
		ipt_do "$1" -t "$2" -I "$3" -d "$_n" -j RETURN
	done
	return 0
}



# 网址过滤匹配串（域名/关键词），逐包 -m string 用。
# 字符集有意不含 *：-m string 是字面匹配，* 不会被当通配符，加进来只会带出
# 无意义的规则并使命令拼接有 glob 风险（旧版为此保留了 set -f hack，已去掉）。
weburl_patterns() {
	# 单一来源：与解析目标 IP 用同一份 entry_domains（domains，缺省回退 word）。
	# 曾经这里是 word ∪ domains，会让改过域名后的旧 word 变成“幽灵匹配源”。
	entry_domains weburl "$1" | tr ' ' '\n' \
		| sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
		| grep -E '^[A-Za-z0-9._/-]+$' | sort -u
}

# 计数用：逐行设备条件各加一条规则（A90）—— 每行 ip 优先、否则 mac，避免 mac+ip 被双计。
# 逐「行」而非逐「词」迭代：一个条件本身含空格（`-m mac --mac-source <mac>`）。
add_dev_rule_single() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action
	local _c
	devcount "$1" "$4" "$5" | while IFS= read -r _c; do
		[ "$_c" = "ALL" ] && _c=""
		ipt_do "$1" -t "$2" -I "$3" $_c $6 $7
	done
	return 0
}

# 按 devmode 选“封锁式（mac/ip 各一条）”还是“计数式（ip 优先单条）”
emit_dev_rule() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action $8=devmode
	if [ "$8" = "single" ]; then
		add_dev_rule_single "$1" "$2" "$3" "$4" "$5" "$6" "$7"
	else
		add_dev_rules "$1" "$2" "$3" "$4" "$5" "$6" "$7"
	fi
}

# 一个条目的全部目标规则——time / protocol / weburl 三类统一入口（封锁与计数共用）。
# $1=module $2=idx $3=IP链 $4=字符串链 $5=gate $6=动作 $7=devmode
emit_entry_targets() { # $1=module $2=idx $3=table $4=IP链 $5=字符串链 $6=gate $7=动作 $8=devmode
	local _pc
	case "$1" in
	time)
		emit_dev_rule "$ipt"  "$3" "$4" time "$2" "$6" "$7" "$8"
		emit_dev_rule "$ipt6" "$3" "$4" time "$2" "$6" "$7" "$8" ;;
	protocol)
		_pc=$(proto_cond "$2")
		emit_dev_rule "$ipt"  "$3" "$4" protocol "$2" "$6 $_pc" "$7" "$8"
		emit_dev_rule "$ipt6" "$3" "$4" protocol "$2" "$6 $_pc" "$7" "$8" ;;
	weburl)
		emit_weburl_targets "$3" "$4" "$5" "$6" "$7" "$2" "$8" ;;
	esac
}

# 一个 weburl 条目的全部目标规则（目标 IP + 明文 DNS/SNI 匹配串）。
# 时段封锁 / 额度封锁 / 额度计数 共用同一个生成器，保证三者枚举的目标集合永远一致。
# $6=devmode：all（默认，mac 与静态IP 各出一条，用于封锁）| single（ip 优先单条，用于计数）
emit_weburl_targets() { # $1=table $2=IP链 $3=字符串链 $4=gate $5=动作 $6=idx [$7=devmode]
	local _algos _f _p _pat _c _dev
	_dev=${7:-all}
	_algos=$(pc_uget "@basic[0].algos"); [ -z "$_algos" ] && _algos=kmp
	_f="$IPDIR/weburl_$6"
	[ -f "$_f" ] && while read -r _p; do
		[ -z "$_p" ] && continue
		case "$_p" in
		*:*) _c=$ipt6 ;;
		*)   _c=$ipt ;;
		esac
		emit_dev_rule "$_c" "$1" "$2" weburl "$6" "$4 -d $_p" "$5" "$_dev"
	done < "$_f"
	for _pat in $(weburl_patterns "$6"); do
		for _c in "$ipt" "$ipt6"; do
			emit_dev_rule "$_c" "$1" "$3" weburl "$6" "$4 -p UDP --dport 53 -m string --algo $_algos --string $_pat" "$5" "$_dev"
			emit_dev_rule "$_c" "$1" "$3" weburl "$6" "$4 -p TCP -m multiport --dports 80,443 -m string --algo $_algos --string $_pat" "$5" "$_dev"
		done
	done
}


# 清掉本插件的自定义链。$1 = 链名**开头匹配**的 BRE（缺省 = 全部自有链 PC[A-Z]*_[^ ]*）。
# 纯清理，**无副作用** —— 不碰 `$STATE_DIR/diagspec`。要让诊断 spec 失效请用
# clean_diag_chains()（D7：失效只跟随「诊断链被清」）。
# 两处 sed 细节是踩过的坑，改之前先看：
#   ① 锚点只能写在 `-N ` 前面，**不能**写进 \(...\) 里 —— BSD sed 把组内的 `^` 当
#      字面量，`..\('^PCA_'\)$` 会一条也不匹配（清链静默失效，stop() 后残留一堆链）；
#   ② 本处 sed 用 BRE（无 alternation），三元族用等价类 `PC[AD][DTC]_` 表达
#      PCAD_/PCDT_/PCDC_（= ERE 的 `PC(AD|DT|DC)_`）。
# -X 只能删「已无人引用」的链，而链之间有引用关系（诊断 PCAD_ → PCDT_ → PCDC_），
# 一轮下来可能剩孤儿 —— 所以循环重试到某一轮再也删不掉为止（real iptables 的 -X
# 成功返回 0、失败非 0，用退出码判断）。
# F-R5-2：每轮必须**先 -F 再 -X** —— 真 iptables 对非空链 -X 报 "Directory not
# empty"；只 -X 时第一轮就删不掉任何带内容的链（PCAD_/PCDT_/PCAW_），_n=0 直接
# break，stop() 后残留几十条 PC*_ 链。先清空再删链，多轮重试解引用依赖。
clean_chains_filter() {
	local _c _ip _n _round _re
	_re=${1:-'PC[A-Z]*_[^ ]*'}
	for _ip in "$ipt" "$ipt6"; do
		[ -n "$_ip" ] || continue
		for _round in 1 2 3 4 5 6; do
			_n=0
			for _c in $($_ip -t mangle -S 2>/dev/null | sed -n "s/^-N \($_re.*\)\$/\1/p"); do
				$_ip -t mangle -F "$_c" 2>/dev/null
				$_ip -t mangle -X "$_c" 2>/dev/null && _n=$((_n + 1))
			done
			[ "$_n" -gt 0 ] || break
		done
	done
	return 0
}

# 清诊断族（PCAD_/PCDT_/PCDC_）+ 失效 diagspec：清链与失效原子（D2-v2 语义保留）。
# 诊断子链被清掉后 diagspec 必须同步失效，否则 build_diag_blocks 的闸门（spec 文本
# 未变）会误判「无事可做」而早退（F1）。
clean_diag_chains() {
	clean_chains_filter 'PC[AD][DTC]_'
	rm -f "$STATE_DIR/diagspec"
	return 0
}

# 兼容壳：清**全部**自有链 + 失效 diagspec。只给 del_rule() 用（全拆，无人重建）；
# builder 一律不用本函数 —— 它们各自只清自己会在同一函数里重建的那一族
# （D6 不变式：任一 builder 都不得清除别的 builder 的链）。
clean_pca_chains() {
	clean_chains_filter 'PC[A-Z]*_[^ ]*'
	rm -f "$STATE_DIR/diagspec"
	return 0
}

# 计数规则：常开（跳进空链 PCA_<key>，读跳转规则的字节计数）
build_acct_rules() { # $1=school|holiday
	local _key _m _i _ip
	# 重建会清空计数器，所以「先采样再重建」必须在这里做：
	# 不变量属于这个函数，调用方（build_all / rebuild_ip_rules）无从违反。
	sample_counters
	for _ip in "$ipt" "$ipt6"; do $_ip -t mangle -F "$TAGA" 2>/dev/null; done
	# D6：只清自己要重建的计数链，不清诊断族/白名单链（谁清谁重建）。
	# 不碰 diagspec —— 诊断完整性不受 acct 重建影响（D7）。
	clean_chains_filter 'PCA_'
	for _key in $(pc_active_keys); do
		_m=${_key%%_*}; _i=${_key#*_}
		ensure_chain "$ipt" mangle "PCA_$_key"
		ensure_chain "$ipt6" mangle "PCA_$_key"
		# 计数式：单一设备条件 + IP/字符串都计入
		emit_entry_targets "$_m" "$_i" mangle "$TAGA" "$TAGA" "" "-j PCA_$_key" single
	done
	# 不删 base.*：本函数开头已采样，保留基线才能把重建后那一分钟也计入
}

# 池内条目用量之和（跳过勾了「不限额度」的成员：他们本来就不该消耗共享池）
pool_usage() { # $1=池名 $2=school|holiday
	local _key _m _i _sum
	_sum=0
	for _key in $(pc_active_keys "$2"); do
		_m=${_key%%_*}; _i=${_key#*_}
		[ "$(pc_entry_pool "$_m" "$_i" "$2")" = "$1" ] || continue
		# 勾了「不限额度」的成员不该消耗共享池（否则会把同池的人提前封掉）
		[ "$(pc_entry_unlimited "$_m" "$_i" "$2")" = "1" ] && continue
		_sum=$((_sum + $(pc_usage_get "$_key")))
	done
	echo "$_sum"
}

# 把某条目封进 TAGQ（设备条件 × 目标）
block_entry() { # $1=module $2=idx
	emit_entry_targets "$1" "$2" mangle "$TAGQ" "$TAGQ" "" "-j DROP" all
}

# ============================================================================
# 黑白名单（第 8 轮 R12/D16/ADR-019）：mode=white = 该设备「默认全封 + 目标放行」
# ============================================================================

# 白名单的「全封该设备」：无目标条件（连条目目标也不可达）。额度耗尽时用。
# 无设备条件的条目绝不装（调用点已由 block_skip_devless 拦下），否则就是全网无条件 DROP。
block_entry_all() { # $1=module $2=idx
	emit_dev_rule "$ipt"  mangle "$TAGQ" "$1" "$2" "" "-j DROP" all
	emit_dev_rule "$ipt6" mangle "$TAGQ" "$1" "$2" "" "-j DROP" all
}

# 白名单的「时段外全封」：设备条件 × 时间条件，同样无目标条件。
block_entry_window_all() { # $1=module $2=idx $3=UTC起秒 $4=UTC止秒
	local _t
	_t="-m time --timestart $(pc_sec_hhmmss "$3") --timestop $(pc_sec_hhmmss "$4")"
	emit_dev_rule "$ipt"  mangle "$TAGQ" "$1" "$2" "$_t" "-j DROP" all
	emit_dev_rule "$ipt6" mangle "$TAGQ" "$1" "$2" "$_t" "-j DROP" all
}

# 允许中的白名单条目：条目设备跳进 PCAW_<key>。
white_entry_jump() { # $1=module $2=idx
	local _key
	_key=$(entry_key "$1" "$2")
	emit_dev_rule "$ipt"  mangle "$TAGQ" "$1" "$2" "" "-j PCAW_$_key" all
	emit_dev_rule "$ipt6" mangle "$TAGQ" "$1" "$2" "" "-j PCAW_$_key" all
}

# 白名单链 PCAW_<key> 的内容：
#   条目目标 RETURN（与封锁同一套目标枚举）→ DNS(53)/DHCP(67/68) RETURN → 末尾 DROP。
# 内容也走 ipt_do（渲染模式只记文本）⇒「记下来的规则 == 下发的规则」对 PCAW 同样成立，
# 目标 IP 变化会改变 spec 文本、从而触发重建（不会留下过期的白名单）。
# 只在真下发时 -N/-F（渲染模式碰内核会瞬时放空白名单）。
white_chain_fill() { # $1=module $2=idx
	local _key _ip
	_key=$(entry_key "$1" "$2")
	for _ip in "$ipt" "$ipt6"; do
		[ -n "$PC_RENDER" ] || ensure_chain "$_ip" mangle "PCAW_$_key"
	done
	emit_entry_targets "$1" "$2" mangle "PCAW_$_key" "PCAW_$_key" "" "-j RETURN" all
	for _ip in "$ipt" "$ipt6"; do
		ipt_do "$_ip" -t mangle -A "PCAW_$_key" -p UDP --dport 53 -j RETURN
		ipt_do "$_ip" -t mangle -A "PCAW_$_key" -p TCP --dport 53 -j RETURN
		ipt_do "$_ip" -t mangle -A "PCAW_$_key" -p UDP -m multiport --dports 67,68 -j RETURN
		ipt_do "$_ip" -t mangle -A "PCAW_$_key" -p UDP -m multiport --sports 67,68 -j RETURN
		ipt_do "$_ip" -t mangle -A "PCAW_$_key" -j DROP
	done
	return 0
}

# 条目生效的额度/已用：挂了池且池有额度就用池的，否则用条目自己的。
# 输出 "<额度> <已用> <池名>"。注意 额度 0 = 一分钟都不给（全禁），不是"不限"；
# 到底受不受额度限制由 pc_entry_unlimited 判定，封锁链/看板/列表页都读同一份。
entry_effective() { # $1=module $2=idx $3=school|holiday
	local _m _i _t _pool _pq _q
	_m=$1; _i=$2; _t=$3
	# 额度取值走唯一实现（common.sh 的 pc_effective_quota），
	# 但「报哪个用量」是本函数自己的事，判据必须是**池里确实有额度**（不是"挂了池"）：
	#   池有额度 → 用了池的额度，报池内合计；否则报条目自己的用量。
	# 输出「有效额度 已用 池名」——封锁链与看板共用。
	_pool=$(pc_entry_pool "$_m" "$_i" "$_t")
	_pq=$(pc_pool_provided_quota "$_m" "$_i" "$_t")
	_q=$(pc_quota_positive "$(pc_effective_quota "$_m" "$_i" "$_t")")
	if [ -n "$_pq" ]; then
		echo "$_q $(pool_usage "$_pool" "$_t") $_pool"
	else
		echo "$_q $(pc_usage_get "$(entry_key "$_m" "$_i")") $_pool"
	fi
}

# 封锁链：① 可用时段之外 ② 额度耗尽（额度 0 即全禁）
# 可用时段之外的封锁规则（$3/$4 = UTC 秒区间；本机 iptables 不支持「! -m time」取反，
# 所以「时段外」一律用正向区间表达，跨 UTC 零点时由 pc_utc_ranges 切成两段）
block_entry_window() { # $1=module $2=idx $3=UTC起秒 $4=UTC止秒
	emit_entry_targets "$1" "$2" mangle "$TAGQ" "$TAGQ" \
		"-m time --timestart $(pc_sec_hhmmss "$3") --timestop $(pc_sec_hhmmss "$4")" "-j DROP" all
}

# 防自锁守卫：无设备条件（= 对全部客户端生效）且拿不到局域网网段时不能封锁 ——
# 无差别 PREROUTING DROP 会把路由器自己也封死。返回 0 表示"应当跳过这条"。
block_skip_devless() { # $1=module $2=idx $3=局域网网段列表
	[ -n "$(pc_clients_rows "$1" "$2")" ] && return 1
	[ -n "$3" ] && return 1
	elog "quota: $1[$2] 无设备条件且拿不到局域网网段，跳过封锁以防自锁"
	return 0
}

# 封锁链的实际下发动作。渲染（判断规则集有没有变）与真下发共用这一份代码，
# 保证「记下来的规则」永远等于「下发的规则」。
# A2/D3 侧信道：把一个 key 的封锁状态追加进签名草稿（`key|reason`）。
# 未设 PC_SIG_OUT（= 真下发那条路径）时零开销：不多一个 fork。
_sig_emit() { # $1=key $2=reason
	[ -n "$PC_SIG_OUT" ] && printf '%s|%s\n' "$1" "$2" >> "$PC_SIG_OUT"
	return 0
}

# 此刻是否在「可用时段」之外。design §5.1 把 `window` 定义为「**时段外**」——
# 这是**当前状态**，不是「配了时段」这个静态事实。用静态事实会让签名恒为 window：
# 跨入/跨出时段永远测不出来，也永远不 purge（A10(a) 要求 none→window 必杀）。
# 0 = 现在在时段外；1 = 在时段内 / 该条目不限时段。
qwin_now_out() { # $1=module $2=idx $3=school|holiday
	local _w _now
	_w=$(pc_qwin_sec "$1" "$2" "$3")
	[ -n "$_w" ] || return 1
	_now=$(pc_hhmmss_to_sec "$(date +%H:%M)")
	[ -n "$_now" ] || return 1
	set -- $_w
	[ "$_now" -lt "$1" ] || [ "$_now" -gt "$2" ]
}

_quota_emit_rules() { # $1=daytype $2=局域网网段列表
	local _key _m _i _a _b _ip _tt _lan _white _out _rsn
	_tt=$1; _lan=$2
	for _key in $(pc_active_keys); do
		_m=${_key%%_*}; _i=${_key#*_}
		block_skip_devless "$_m" "$_i" "$_lan" && continue
		_white=0
		[ "$(pc_uget "@$_m[$_i].mode")" = "white" ] && _white=1
		if [ "$_white" = 1 ]; then
			# 白名单（D16/ADR-019）：判定口径与黑名单完全一致（可用时段 + 额度），
			# 只是「封什么」不同 —— 允许中只放行条目目标（其余全封），被全封则整台设备全封。
			if [ "$(pc_entry_unlimited "$_m" "$_i" "$_tt")" != "1" ]; then
				set -- $(entry_effective "$_m" "$_i" "$_tt")
				if [ "$2" -ge "$1" ]; then
					# 被全封：只发无目标条件的全封，连条目目标也不可达
					block_entry_all "$_m" "$_i"
					_sig_emit "$_key" white_all
					continue
				fi
			fi
			# 允许中：先建/填 PCAW 链，再发 TAGQ 的 PCAW 跳转，最后发时段外全封。
			# 跳转必须晚于目标链建立：真 iptables 不认尚未 -N 的 -j 目标，而 ipt_do
			# 吞 stderr ⇒ 跳转静默丢失（替身硬化后白盒可测，第 10 轮 R15）。
			# -I 是头插，后发射者在前，于是「时段外全封」排在「PCAW 跳转」之前先命中；
			# 时段内落到 PCAW 跳转。
			white_chain_fill "$_m" "$_i"
			white_entry_jump "$_m" "$_i"
			# 先存进变量再遍历（不重复调 pc_qwin_out_ranges，但也**不得**用 <<<：
			# busybox ash 不支持 here-string）。下发顺序与参数与改动前完全一致。
			_out=$(pc_qwin_out_ranges "$_m" "$_i" "$_tt")
			printf '%s\n' "$_out" | while read -r _a _b; do
				[ -n "$_a" ] && block_entry_window_all "$_m" "$_i" "$_a" "$_b"
			done
			_rsn=none
			qwin_now_out "$_m" "$_i" "$_tt" && _rsn=window
			_sig_emit "$_key" "$_rsn"
			continue
		fi
		# ① 可用时段之外
		_out=$(pc_qwin_out_ranges "$_m" "$_i" "$_tt")
		printf '%s\n' "$_out" | while read -r _a _b; do
			[ -n "$_a" ] && block_entry_window "$_m" "$_i" "$_a" "$_b"
		done
		# ② 额度耗尽。额度 0 时 0>=0 恒成立 → 全禁，不需要专门分支；
		#    勾了「不限额度」则只受 ① 约束。
		# reason 优先级（D3/design §5.1）：white_all > quota > window > none。
		_rsn=none
		qwin_now_out "$_m" "$_i" "$_tt" && _rsn=window
		if [ "$(pc_entry_unlimited "$_m" "$_i" "$_tt")" = "1" ]; then
			_sig_emit "$_key" "$_rsn"
			continue
		fi
		set -- $(entry_effective "$_m" "$_i" "$_tt")
		if [ "$2" -ge "$1" ]; then
			block_entry "$_m" "$_i"
			_rsn=quota
		fi
		_sig_emit "$_key" "$_rsn"
	done
	# 最后插入「放行到局域网网段」的规则（含路由器自身 IP），SSH/LuCI 才不会被
	# 自己的封锁断掉。必须排在所有封锁规则之前，而 -I 是插到最前，故放在最后插入。
	for _ip in "$ipt" "$ipt6"; do
		allow_lan_in "$_ip" mangle "$TAGQ"
	done
	return 0
}

# 把本次「应当下发的规则」渲染成文本（不碰内核；靠 ipt_do 的 PC_RENDER 模式）
render_quota_spec() { # $1=daytype $2=局域网网段列表
	local _f
	mkdir -p "$STATE_DIR"
	_f="$STATE_DIR/spec.$$"
	: > "$_f"
	PC_RENDER="$_f"
	_quota_emit_rules "$1" "$2"
	unset PC_RENDER
	cat "$_f"
	rm -f "$_f"
	return 0
}

# 规则文本里各协议族的条数（输出 "v4数 v6数"）。只数**插进 $2 指定 tag** 的 -I 行：
# 同一份 spec 里还记着白名单链 PCAW_* 的内容（-A 行），它们不在封锁链里，
# 不能混进「链内条数」校验（否则每次都判为变化、每分钟重建 → 制造封锁空窗）。
spec_rule_counts() { # $1=spec文本 $2=要数的 tag（TAGQ 或 TAGD）
	printf '%s\n' "$1" | awk -F'|' -v t="$2" '
		{ if (index($0, " -I " t) > 0) n[$1]++ }
		END { printf "%d %d", n["v4"]+0, n["v6"]+0 }'
}

live_rule_count() { # $1=ipcmd $2=链名 → 链内规则条数
	$1 -t mangle -S "$2" 2>/dev/null | grep -c '^-A'
}

# 封锁链，两个来源（每个已启用条目都有「可用时段 + 额度」）：
#   ① 不在可用时段内 → 封（内核 -m time 精确到秒，不依赖 tick）
#   ② 额度用完 → 整条封（比时段封更强，所以不需要时间条件）
# 额度 0 = 一分钟都不给（② 恒成立）；勾了「不限额度」的条目只受 ① 约束。
#
# 每分钟 tick 都会走这里，而「先 -F 再逐条重建」会让封锁链短暂为空
#（实测约 1.3s／分钟，那段窗口里 iPad 的时段封与额度封全部失效）。
# 所以先把规则集渲染一遍：和上次一致、且链里条数也对得上，就一个 iptables 都不动。
# 条数必须一起校验 —— 链被外部清空（fw4 reload）时只有它能发现。
build_quota_blocks() {
	local _tt _lan _spec _old _ccnt _lcnt _ip
	_tt=$(pc_today_type)
	_lan=$(pc_lan_nets)
	# A2/D3：签名草稿（`key|reason` 逐行）由渲染时的侧信道产出，供 sync_offload 用。
	# 注意不能写成「赋值前缀 + $( )」——`PC_SIG_OUT=x _spec=$(...)` 里那个赋值
	# **不进子 shell**（本仓 PC_RENDER 已踩过同一个坑）：先赋值、再调函数、最后清空。
	mkdir -p "$STATE_DIR"
	# A14/M1：签名草稿用**私有**路径（带 $$）—— build_all 里它要活过整个 build_diag_blocks
	# 才被 sync_offload 读；固定共享路径会被并发的 ensure 截断 ⇒ 读到空 #keys ⇒ 白杀两次。
	# 变量赋值必须在同一 shell（不能用 `PC_SIG_CUR=x $( )` 前缀形式，见下条注释）。
	PC_SIG_CUR="$STATE_DIR/offloadsig.cur.$$"
	: > "$PC_SIG_CUR"
	PC_SIG_OUT="$PC_SIG_CUR"
	_spec=$(render_quota_spec "$_tt" "$_lan")
	PC_SIG_OUT=
	_ccnt=$(spec_rule_counts "$_spec" "$TAGQ")
	_old=$(cat "$STATE_DIR/quotaspec" 2>/dev/null)
	_lcnt="$(live_rule_count "$ipt" "$TAGQ") $(live_rule_count "$ipt6" "$TAGQ")"
	if [ "$_spec" = "$_old" ] && [ "$_ccnt" = "$_lcnt" ]; then
		return 0
	fi
	mkdir -p "$STATE_DIR"
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGQ"
		$_ip -t mangle -F "$TAGQ" 2>/dev/null
	done
	# TAGQ 已清空 ⇒ 白名单链 PCAW_* 此刻无人引用，顺手回收（条目被禁用/删除/改成黑名单后
	# 不会留下孤儿链）；下面 _quota_emit_rules 会为仍在用的白名单条目重新建链。
	# D6：只清自己会重建的 PCAW_（不放宽到 PC[A-Z]*_ —— 那会连诊断链和计数链一起清）；
	# D7：不碰 diagspec，否则配额重建会强制诊断全量重建（F-3）。
	clean_chains_filter 'PCAW_'
	_quota_emit_rules "$_tt" "$_lan"
	printf '%s' "$_spec" > "$STATE_DIR/quotaspec"
	return 0
}

# ============================================================================
# 诊断明细（第 8 轮 R13/D19/ADR-020）
#   语义：对每个**启用**的网址条目 E，把「命中了 E 的目标、但不在 E 的设备范围
#   （mac ≠ E.mac 且 ip ≠ E.ip）」的 LAN 客户端流量，按 (E, 客户端) 与 (E, 目标) 记账。
#   链：TAGD（PARENTCONTROL_DIAG，挂在 PREROUTING 最后）
#        → PCAD_<key>（每个目标一条 → PCDT_<key>_<t>）
#        → PCDT_<key>_<t>（每个未覆盖客户端一条 -m mac → PCDC_<key>_<c>）
#        → PCDC_<key>_<c>（空链，仅作计数身份）
#   诊断链内**只有跳转**：没有 DROP/ACCEPT/RETURN，不改道、不丢包、不参与封锁与计时。
#   计数器身份 = 跳转目标链名（与 acct_bytes 读 PCA_<key> 同构）：
#     · 每条目「目标数」个 PCDT 链 → 每个目标的命中量
#     · 每条目「未覆盖客户端数」个 PCDC 链 → 每个客户端命中该条目目标的量
#   只有「有设备条件」且「有可枚举目标」的网址条目才装（时间/协议条目没有目标集）。
# ============================================================================

# 未覆盖客户端（一行一个 mac；在线优先、按 mac 升序，上限 PC_DIAG_MAX）
diag_clients() { # $1=module $2=idx
	local _emacs _eips
	_emacs=$(pc_clients_macs "$1" "$2")
	_eips=$(pc_clients_ips "$1" "$2")
	# 没有任何设备条件的条目 = 对所有客户端生效 ⇒ 不存在「未覆盖客户端」
	[ -n "$_emacs$_eips" ] || return 0
	# 排除集经 ENVIRON 传入（多值、按行分隔）：-v 无法承载含空格/$/反斜杠的值（A93/C5）
	(
		export PC_DIAG_EX_MACS="$_emacs"
		export PC_DIAG_EX_IPS="$_eips"
		hosts_tsv | awk '
			BEGIN {
				n = split(ENVIRON["PC_DIAG_EX_MACS"], a, "\n")
				for (k = 1; k <= n; k++) if (a[k] != "") exm[a[k]] = 1
				n = split(ENVIRON["PC_DIAG_EX_IPS"], b, "\n")
				for (k = 1; k <= n; k++) if (b[k] != "") exi[b[k]] = 1
			}
			$1 == "host" && $2 != "" {
				mac = tolower($2)
				if (mac in exm) next
				if ($3 != "" && ($3 in exi)) next
				print $5, mac
			}' | sort -k1,1r -k2,2 | head -n "$PC_DIAG_MAX" | awk '{ print $2 }'
	)
	return 0
}

# 条目的目标枚举（与封锁/计数同一套源：IP 目录 + 明文 DNS/SNI 串）
diag_targets() { # $1=module $2=idx
	local _f
	_f="$IPDIR/weburl_$2"
	[ -f "$_f" ] && grep -v '^$' "$_f"
	# 注意：weburl_patterns 只吃「下标」（模块名在它内部写死）
	weburl_patterns "$2"
	return 0
}

# PCDT_<key>_<t> 的内容：每个未覆盖客户端一条（跳该客户端的空计数链 PCDC_<key>_<c>）。
# 该链只被目标规则跳入 ⇒ PCDC 的字节数 = 该客户端命中「该条目目标」的流量。
diag_client_rules() { # $1=ipcmd $2=key $3=目标序号 $4=客户端文件
	local _c _key _t _cf _nh _mac
	_c=$1; _key=$2; _t=$3; _cf=$4
	[ -n "$PC_RENDER" ] || ensure_chain "$_c" mangle "PCDT_${_key}_$_t"
	_nh=0
	while read -r _mac; do
		[ -n "$_mac" ] || continue
		_nh=$((_nh + 1))
		ipt_do "$_c" -t mangle -A "PCDT_${_key}_$_t" -m mac --mac-source "$_mac" -j "PCDC_${_key}_$_nh"
	done < "$_cf"
	return 0
}

# 诊断链的渲染 / 真下发（渲染模式只记文本，绝不碰内核）
_diag_emit_rules() {
	local _key _m _i _tf _itf _cf _n _c _c2 _mac _p _algos _nh _sd
	_algos=$(pc_uget "@basic[0].algos"); [ -z "$_algos" ] && _algos=kmp
	# A116（design §11.25.2 / F-6）：临时文件不得落在持久状态目录 $STATE_DIR。原先
	# diag.ip/diag.t/diag.c 三个 scratch 都写成 "$STATE_DIR/diag.*.$$"：进程被 OOM/kill
	# 打断就永久遗留到状态目录里（重启、升级都不清，且会让「状态目录=持久状态」的口径破产）。
	# 现统一放进一次性 scratch 目录（/tmp，tmpfs，重启自清），函数退出时整目录删掉。
	_sd=${TMPDIR:-/tmp}/pc-diag.$$
	mkdir -p "$_sd" 2>/dev/null
	_tf="$_sd/t"; _cf="$_sd/c"
	for _key in $(pc_active_keys); do
		_m=${_key%%_*}; _i=${_key#*_}
		[ "$_m" = "weburl" ] || continue          # 只有网址条目有可枚举的目标
		diag_clients "$_m" "$_i" > "$_cf"
		[ -s "$_cf" ] || continue                 # 无未覆盖客户端 → 一个规则都不装
		diag_targets "$_m" "$_i" > "$_tf"
		[ -s "$_tf" ] || continue
		# ① TAGD → PCAD_<key>（整个条目一条；链内再按目标/客户端分流）
		for _c2 in "$ipt" "$ipt6"; do
			[ -n "$PC_RENDER" ] || ensure_chain "$_c2" mangle "PCAD_$_key"
			ipt_do "$_c2" -t mangle -I "$TAGD" -j "PCAD_$_key"
		done
		# ② 客户端计数链（空链，仅作身份）先建好：PCDC_<key>_<c>
		_nh=0
		for _mac in $(cat "$_cf"); do
			_nh=$((_nh + 1))
			for _c2 in "$ipt" "$ipt6"; do
				[ -n "$PC_RENDER" ] || ensure_chain "$_c2" mangle "PCDC_${_key}_$_nh"
			done
		done
		# ③a IP 目标（来自 IP 目录）：按地址族给一条 -d，目标序号与
		#    diag_targets 的输出顺序一致（IP 在前、匹配串在后）——采样靠它对齐。
		_n=0
		_itf="$_sd/ip"
		[ -f "$IPDIR/weburl_$_i" ] && grep -v '^$' "$IPDIR/weburl_$_i" > "$_itf"
		while read -r _p; do
			[ -n "$_p" ] || continue
			_n=$((_n + 1))
			case "$_p" in *:*) _c=$ipt6 ;; *) _c=$ipt ;; esac
			# 先建/填 PCDT_<key>_<n>（diag_client_rules 里 ensure），再插 PCAD_ 跳转：
			# 反序会让 -j PCDT_ 指到尚未 -N 的链，真 iptables 拒绝且 ipt_do 吞 stderr
			# ⇒ 规则静默丢失（替身硬化后白盒可测，第 10 轮 R15）。
			diag_client_rules "$_c" "$_key" "$_n" "$_cf"
			ipt_do "$_c" -t mangle -I "PCAD_$_key" -d "$_p" -j "PCDT_${_key}_$_n"
		done < "$_itf"
		rm -f "$_itf"
		# ③b 匹配串目标（明文 DNS/SNI，与封锁同源）：两族各两条
		for _p in $(weburl_patterns "$_i"); do
			_n=$((_n + 1))
			for _c in "$ipt" "$ipt6"; do
				# 同上：先建/填 PCDT_ 链，再插 PCAD_ 跳转
				diag_client_rules "$_c" "$_key" "$_n" "$_cf"
				ipt_do "$_c" -t mangle -I "PCAD_$_key" -p UDP --dport 53 \
					-m string --algo "$_algos" --string "$_p" -j "PCDT_${_key}_$_n"
				ipt_do "$_c" -t mangle -I "PCAD_$_key" -p TCP -m multiport --dports 80,443 \
					-m string --algo "$_algos" --string "$_p" -j "PCDT_${_key}_$_n"
			done
		done
	done
	rm -rf "$_sd"
	return 0
}

render_diag_spec() {
	local _f
	mkdir -p "$STATE_DIR"
	_f="$STATE_DIR/dspec.$$"
	: > "$_f"
	PC_RENDER="$_f"
	_diag_emit_rules
	unset PC_RENDER
	cat "$_f"
	rm -f "$_f"
	return 0
}

# 诊断钩子完整性（A1/D1-v2）：v4 与 v6 **分别**判定，任一族不完整即整体不完整。
# 返回 0 = 完整、非 0 = 不完整。$1 可传 spec 文本；缺省读 $STATE_DIR/diagspec
# （闸门里只在「文本未变」时才会走到这里，此时该文件内容即当前 spec）。
# D3-v2：稳态 iptables 调用次数不得增加 —— 每族**只** fork 一次 `-t mangle -S`，
# 一份输出里解析出全部判据；实测数十条诊断链，逐链 fork 会把 tick 拖到分钟级。
# 判据（D1-v2，期望/实际同口径「按链规则条数一致」）：
#   ① TAGD 跳转条数 == spec 里的 -I TAGD 条数（hops=）；
#   ② 每个 PCAD_<key> 的规则条数 == spec 里该族 -I PCAD_<key> 的行数（chain=cnt）。
# 「链存在」「至少一跳」都被「条数一致」蕴含；单族目标（另一族 PCAD 合法空壳、
# spec 该族也无 -I PCAD_ 行）⇒ 双方都不出现该链 ⇒ 判完整（B1 修正）。
diag_hooks_present() {
	local _spec _fam _ip _exp _act
	_spec=${1:-$(cat "$STATE_DIR/diagspec" 2>/dev/null)}
	_fam=v4
	for _ip in "$ipt" "$ipt6"; do
		if [ -n "$_ip" ]; then
			# 期望（按族）：TAGD 跳转条数 + 该族每个 PCAD_<key> 应接的规则条数
			_exp=$(printf '%s\n' "$_spec" | awk -F'|' -v f="$_fam" -v t="$TAGD" '
				$1 == f {
					if (index($0, " -I " t) > 0) hops++
					n = split($0, a, " ")
					for (i = 1; i < n; i++)
						if (a[i] == "-I" && a[i + 1] ~ /^PCAD_/) cnt[a[i + 1]]++
				}
				END {
					for (c in cnt) if (cnt[c] > 0) print c "=" cnt[c]
					printf "hops=%d\n", hops + 0
				}' | sort)
			# 实际（同一份 -S 输出）：每个 PCAD_ 链内的 -A 条数 + TAGD 跳转条数
			_act=$($_ip -t mangle -S 2>/dev/null | awk -v t="$TAGD" '
				$1 == "-A" && $2 ~ /^PCAD_/ { cnt[$2]++ }
				$1 == "-A" && $2 == t { hops++ }
				END {
					for (c in cnt) if (cnt[c] > 0) print c "=" cnt[c]
					printf "hops=%d\n", hops + 0
				}' | sort)
			[ "$_act" = "$_exp" ] || return 1
		fi
		_fam=v6
	done
	return 0
}

# 闸门：spec 文本未变 + `diag_hooks_present` 判完整（该谓词内含 TAGD 跳数 `hops=`）
# ⇒ 一个 iptables 都不动。文本未变而诊断子链已被清空时，靠谓词抓住并重建。
build_diag_blocks() {
	local _spec _old _ip
	[ -n "$ipt" ] || return 0
	_spec=$(render_diag_spec)
	_old=$(cat "$STATE_DIR/diagspec" 2>/dev/null)
	# A2/D1-v2/D3-v2：文本未变且钩子完整 ⇒ 一个 iptables 都不动（稳态只读 -S 每族 1 次共 2 次）。
	# 删掉了旧的 _ccnt/_lcnt 与两次 live_rule_count fork：TAGD 跳数一致已由 diag_hooks_present 的 hops= 覆盖。
	if [ "$_spec" = "$_old" ] && diag_hooks_present "$_spec"; then
		return 0
	fi
	# A7：走到这里说明闸门没过。文本未变 ⇒ 唯一原因是钩子不完整，
	# 打一条可辨识日志（稳态完整时上一行就 return 了，故稳态 0 行）。
	if [ "$_spec" = "$_old" ]; then
		elog "diag: hooks incomplete → rebuild"
	fi
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGD"
		$_ip -t mangle -F "$TAGD" 2>/dev/null
	done
	# TAGD 已清空 ⇒ 旧的 PCAD_/PCDT_/PCDC_ 无人引用，顺手回收。
	# D7：清诊断族 + 失效 diagspec 是同一件事（clean_diag_chains 内含 rm），否则下次闸门
	# 会因「spec 文本未变」误判无事可做而早退（F1）；且只清诊断族，不波及 PCA_/PCAW_。
	clean_diag_chains
	_diag_emit_rules
	printf '%s' "$_spec" > "$STATE_DIR/diagspec"
	return 0
}

# ---- 诊断采样与落盘（与额度计数同一阈值、同一「先采样后重建」口径）----

# 今日诊断文件（TAB 分隔：c/t 两种行，见 D19）
diag_file() { echo "$USAGE_DIR/diag/$(date +%Y%m%d)"; }

# 本分钟增量（与额度计数同一算法：计数器可被重建清零，回零时按「清零后的值」计）
# 输出增量并把当前值写回基线文件。
diag_delta() { # $1=当前字节 $2=基线文件
	local _b _d
	_b=0
	[ -f "$2" ] && _b=$(cat "$2" 2>/dev/null)
	case "$_b" in ''|*[!0-9]*) _b=0 ;; esac
	if [ "$1" -ge "$_b" ]; then _d=$(( $1 - _b )); else _d=$1; fi
	echo "$1" > "$2"
	echo "$_d"
}

# t <entry_key> <target> <minutes>
diag_bump_t() { # $1=key $2=target
	local _f _now
	_f=$(diag_file); _now=$(date +%H:%M:%S)
	mkdir -p "$USAGE_DIR/diag"
	[ -f "$_f" ] || : > "$_f"
	awk -F'\t' -v OFS='\t' -v k="$1" -v tg="$2" -v now="$_now" '
		$1 == "t" && $2 == k && $3 == tg { $4 = $4 + 1; hit = 1 }
		{ print }
		END { if (!hit) print "t", k, tg, 1 }' "$_f" > "$_f.new" && mv "$_f.new" "$_f"
	return 0
}

# D31/A44：条目展示名（诊断区 live 与 c 行快照共用）：remarks → apps 首行名 → 空串；去 TAB/CR/LF。
entry_disp_name() { # $1=entry_key（<模块>_<下标>）
	local _m=${1%%_*} _i=${1#*_} _n
	_n=$(pc_uget "@$_m[$_i].remarks" | tr -d '\t\r\n')
	[ -n "$_n" ] || _n=$(pc_apps_rows "$(pc_uget "@$_m[$_i].apps")" | head -n 1 | cut -f1 | tr -d '\t\r\n')
	printf '%s' "$_n"
}

# c <entry_key> <mac> <ip> <hostname> <minutes> <first> <last> <name>；minutes+1、first 只写一次、
# last 每次刷新（A24/W101）。$4–$8 位置/语义不变；$9=展示名快照（D31/A44，每次 bump 重写）。
diag_bump_c() { # $1=key $2=mac $3=ip $4=hostname
	local _f _now
	_f=$(diag_file); _now=$(date +%H:%M:%S)
	mkdir -p "$USAGE_DIR/diag"
	[ -f "$_f" ] || : > "$_f"
	# nm/hn 是字符串类传参，改走环境：awk -v 会解释反斜杠转义（a\tb→真 TAB、
	# a\\b 丢反斜杠、\061→1），ENVIRON 原样透传（A47/review10 Low-1）。
	# 字符集受控的 k/mc/ip/now 仍用 -v；$4–$8 位置与语义逐字节不变。
	nm=$(entry_disp_name "$1") hn="$4" \
		awk -F'\t' -v OFS='\t' -v k="$1" -v mc="$2" -v ip="$3" -v now="$_now" 'BEGIN{ nm = ENVIRON["nm"]; hn = ENVIRON["hn"] }
		$1 == "c" && $2 == k && $3 == mc {
			$6 = $6 + 1
			if ($4 == "" || $4 == "-") $4 = ip
			if ($5 == "" || $5 == "-") $5 = hn
			if ($7 == "") $7 = now
			$8 = now
			$9 = nm
			hit = 1
		}
		{ print }
		END { if (!hit) print "c", k, mc, ip, hn, 1, now, now, nm }' "$_f" > "$_f.new" && mv "$_f.new" "$_f"
	return 0
}

# 取值助手（A83-2）：$1=表内容（`k|v|…` 以 `|` 串联）$2=键 ⇒ 结果放全局 _MV（有意不加 local）。
diag_map_get() { _MV=${1#*"|$2|"}; [ "$_MV" = "$1" ] && { _MV=0; return 0; }; _MV=${_MV%%|*}; }

# 每分钟采样：目标维（PCAD → PCDT）与客户端维（PCDT → PCDC）各按同一阈值判一次。
sample_diag_counters() { # $1=阈值（字节）
	local _thr _key _m _i _n _v _bf _d _mac _tg _dump _tf _hosts _ip _hn _k _map _ln _map_c _map_t _b _r _NL _pak _dead
	[ -n "$ipt" ] || return 0
	# 没装诊断链（未启用 / 无未覆盖客户端）就不采样
	$ipt -t mangle -n -L "$TAGD" >/dev/null 2>&1 || return 0
	_thr=$1; mkdir -p "$STATE_DIR" "$USAGE_DIR/diag"
	_dump="$STATE_DIR/diag.dump.$$"; _tf="$STATE_DIR/diag.tg.$$"; _map="$STATE_DIR/diag.map.$$"
	{ $ipt -t mangle -nvx -L 2>/dev/null; $ipt6 -t mangle -nvx -L 2>/dev/null; } > "$_dump"
	# A83-1：单遍化的唯一一次 awk（默认 FS，容忍行首空格计数列）。c|<链>|<目标>|<和> 按 (链,目标)
	# 累加；t|<目标>|<和> 按目标跨全部链累加（不得加 ^PC 过滤，否则非 PC* 链跳向 PCDC_* 时与旧算法分叉）。
	awk '
		/^Chain / { ch = $2; next }
		$1 ~ /^[0-9]+$/ { s[ch "|" $3] += $2; t[$3] += $2 }
		END { for (k in s) print "c|" k "|" s[k]; for (k in t) print "t|" k "|" t[k] }' "$_dump" > "$_map"
	# A83-2：两表一次 read 循环读进变量并 `|` 串成 `…k|v|`（不得用 $(cat)，会多一个 fork）。
	_map_c=; _map_t=
	while IFS= read -r _ln; do
		case "$_ln" in t*) _map_t="$_map_t$_ln|" ;; c*) _map_c="$_map_c$_ln|" ;; esac
	done < "$_map"
	_NL='
'
	_hosts="$_NL$(hosts_tsv 2>/dev/null)"
	for _key in $(pc_active_keys); do _m=${_key%%_*}; _i=${_key#*_}
		[ "$_m" = "weburl" ] || continue; $ipt -t mangle -n -L "PCAD_$_key" >/dev/null 2>&1 || continue
		_n=0; diag_targets "$_m" "$_i" > "$_tf"; while read -r _tg; do [ -n "$_tg" ] || continue
			_n=$((_n + 1))
			# 目标侧查 `c|` 表（键带链名，A83-1b）；行首空格计数列 ⇒ 按「首字段纯数字」识别规则行。
			diag_map_get "$_map_c" "PCAD_$_key|PCDT_${_key}_$_n"; _v=$_MV
			_bf="$STATE_DIR/dbase.${_key}.t$_n"
			# A83-3：基线纯 shell（取代 $(diag_delta …)）；缺失/非法按 0；回零按 _v 计；无论是否命中都写回。
			_b=0; [ -f "$_bf" ] && IFS= read -r _b < "$_bf" 2>/dev/null; case "$_b" in ''|*[!0-9]*) _b=0 ;; esac
			if [ "$_v" -ge "$_b" ]; then _d=$((_v - _b)); else _d=$_v; fi; printf '%s\n' "$_v" > "$_bf"
			[ "$_d" -gt 0 ] && [ "$_d" -ge "$_thr" ] && diag_bump_t "$_key" "$_tg"
		done < "$_tf"
		_n=0; for _mac in $(diag_clients "$_m" "$_i"); do _n=$((_n + 1))
			diag_map_get "$_map_t" "PCDC_${_key}_$_n"; _v=$_MV
			_bf="$STATE_DIR/dbase.${_key}.c$_n"
			_b=0; [ -f "$_bf" ] && IFS= read -r _b < "$_bf" 2>/dev/null; case "$_b" in ''|*[!0-9]*) _b=0 ;; esac
			if [ "$_v" -ge "$_b" ]; then _d=$((_v - _b)); else _d=$_v; fi; printf '%s\n' "$_v" > "$_bf"
			[ "$_d" -gt 0 ] && [ "$_d" -ge "$_thr" ] || continue
			# A83-4：客户端 _ip/_hn 由同一份 _hosts 纯 shell 查（取代每客户端 2 次 printf|awk）。
			_r=${_hosts#*"$_NL""host $_mac "}; [ "$_r" = "$_hosts" ] && _r=""; _r=${_r%%"$_NL"*}; _ip=${_r%% *}; _hn=${_r#* }; _hn=${_hn%% *}
			diag_bump_c "$_key" "$_mac" "$_ip" "$_hn"
		done
	done
	rm -f "$_dump" "$_tf" "$_map"
	# 条目被删/禁用后清掉它的诊断基线（与 base.* 同思路）
	# A110（design §11.25.2 / F-1）：`pc_active_keys` 提到循环外 —— 原先每个 dbase.* 各起
	# 1 个 `pc_active_keys` 子 shell + 1 个 `grep -qx` ⇒ N 个文件 = 2N fork。真机 49 个文件
	# 实测 ~3160ms（test-report §15）；提出去 + 纯 shell 整行匹配后 ≈ 240ms，且整循环只
	# 剩 1 次 fork（pc_active_keys 本身）≤ 2。用 $_NL 包边做整行匹配（非子串），避免
	# `weburl_1` 误命中 `weburl_10`。
	_pak="$_NL$(pc_active_keys)$_NL"
	_dead=
	for _bf in "$STATE_DIR"/dbase.*; do
		[ -e "$_bf" ] || continue
		_k=${_bf##*/dbase.}
		_k=${_k%%.*}
		case "$_pak" in *"$_NL$_k$_NL"*) ;; *) _dead="$_dead ${_bf##*/}" ;; esac
	done
	# 一次性删（子 shell 里 cd 到 $STATE_DIR 用相对名）：`rm` 逐文件也是 fork，不清账的话
	# 「整循环 ≤2 fork」就不成立 —— 100 个残留会变成 100 次 rm（实测 90 个差值 ≈154ms）。
	# dbase.<键> 的名字由 pc_active_keys 的 `模块_下标` 构成，不含空格，故可直接展开。
	[ -n "$_dead" ] && ( cd "$STATE_DIR" && rm -f $_dead )
	return 0
}

# 额度计数链名（供 sample 读取）
active_acct_keys() { pc_active_keys; }

# ============================================================================
# 用量采样：每分钟对比计数增量，超阈值记 1 分钟
# ============================================================================
sample_counters() {
	local _min_kb _thr _dump _key _v _bf _b _d _k
	mkdir -p "$STATE_DIR"
	_min_kb=$(pc_uget "@basic[0].usage_min_kb")
	case "$_min_kb" in ''|*[!0-9]*) _min_kb=8 ;; esac
	_thr=$((_min_kb * 1024))
	_dump="$STATE_DIR/acct.sample.$$"; dump_acct "$_dump"
	for _key in $(active_acct_keys); do
		_v=$(acct_bytes "$_key" "$_dump")
		_bf="$STATE_DIR/base.$_key"
		if [ -f "$_bf" ]; then
			_b=$(cat "$_bf")
			if [ "$_v" -ge "$_b" ]; then _d=$((_v - _b)); else _d=$_v; fi
		else
			# 首次采样（开机/重建后）：计数器当前值就是“自规则建立以来”的流量，
			# 直接按它判一次，否则这段时间的用量会被白白丢掉。
			_d=$_v
		fi
		# 必须有实际流量（_d>0）且达到阈值才记，否则阈值 0 时零流量也会记一分钟
		[ "$_d" -gt 0 ] && [ "$_d" -ge "$_thr" ] && pc_usage_add "$_key" 1
		echo "$_v" > "$_bf"
	done
	rm -f "$_dump"
	for _bf in "$STATE_DIR"/base.*; do
		[ -e "$_bf" ] || continue
		_k=${_bf##*/base.}
		active_acct_keys | grep -qx "$_k" || rm -f "$_bf"
	done
	# 诊断明细与额度计数同一口径（同一阈值、同一「先采样后重建」不变量，R21/W101）
	sample_diag_counters "$_thr"
}

# ============================================================================
# 生命周期
# ============================================================================
build_all() {
	local _tt _ip
	# A52/D35：跳转数量/顺序不对（重复跳转、Q/A/D 错序）→ 先拆干净，下面按既有
	# hook_chain 顺序（D→A→Q 头插 ⇒ 最终 Q→A→D）整套重建；顺序正确时零额外调用。
	pc_hooks_present || pc_unhook_all
	_tt=$(pc_today_type)
	elog "build: day=$_tt"
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGA"; $_ip -t mangle -F "$TAGA" 2>/dev/null
		# TAGQ 的**清空**其实就由下一行的 ensure_chain 完成：ensure_chain 是「-N || -F」
		# （:84-86），链已存在时 -N 失败 ⇒ 走 -F 把 TAGQ 清空。所以 build_all() 是**全量重建
		# 路径**——每次都真的清空 TAGQ，随后由 build_quota_blocks 重建（它看到的已是空链，
		# _lcnt=0 ≠ _ccnt ⇒ 闸门必然不早退）。清空→填充之间有短暂空链窗口（结构决定，pre-existing）。
		# **A4「稳态零写」的边界**：它只在 tick_body 路径成立（那里不调 ensure_chain，直接
		# sample_counters → build_quota_blocks → build_diag_blocks）；build_all() 本身不是稳态探针。
		ensure_chain "$_ip" mangle "$TAGQ"
		# F-R5-3：TAGD 也必须在 hook 之前先建出来 —— hook_chain 是「-C || -I」
		# 且吞 stderr，目标链不存在时 -I 静默失败，诊断链就永远没有跳转而 0
		# references（del_rule 每次 stop/restart 都会把三条链 -X 掉，真机实测）。
		ensure_chain "$_ip" mangle "$TAGD"
	done
	build_acct_rules "$_tt"
	# PREROUTING 顺序必须是 TAGQ → TAGA → TAGD：封锁链在前（被封的包不再进计数链），
	# 计数链居中，诊断链最后（只计数、不改道）。hook_chain 用 -I 插到链首，
	# 所以按 D → A → Q 的顺序挂，最终就是 Q 在前、D 在最后。
	for _ip in "$ipt" "$ipt6"; do
		hook_chain "$_ip" mangle PREROUTING "$TAGD"
		hook_chain "$_ip" mangle PREROUTING "$TAGA"
		hook_chain "$_ip" mangle PREROUTING "$TAGQ"
	done
	build_quota_blocks
	build_diag_blocks
	sync_offload
	echo "$_tt" > "$STATE_DIR/daytype"
}

del_rule() {
	local _ip _ta _c
	for _ip in "$ipt" "$ipt6"; do
		# A51/D35：PREROUTING 跳转「删到删不动」（外部注入的重复跳转一次收敛）。
		# 必须先摘跳转再 -X 链：链仍被 PREROUTING 引用时 -X 会失败（真 iptables 行为）。
		pc_unhook_all_family "$_ip"
		for _ta in "$TAGQ" "$TAGA" "$TAGD"; do
			$_ip -t mangle -F "$_ta" 2>/dev/null
			$_ip -t mangle -X "$_ta" 2>/dev/null
		done
		# 老版本残留（统一模型之前）：filter 表的时间/协议/网址链、mangle 表的网址/IP 链
		for _c in INPUT FORWARD OUTPUT; do
			for _ta in PARENTCONTROL_TIME PARENTCONTROL_PROTOCOL PARENTCONTROL_WEBURL; do
				$_ip -D "$_c" -j "$_ta" 2>/dev/null
			done
		done
		for _ta in PARENTCONTROL_TIME PARENTCONTROL_PROTOCOL PARENTCONTROL_WEBURL; do
			$_ip -F "$_ta" 2>/dev/null
			$_ip -X "$_ta" 2>/dev/null
		done
		for _ta in PARENTCONTROL_WEBURL PARENTCONTROL_IP; do
			$_ip -t mangle -D PREROUTING -j "$_ta" 2>/dev/null
			$_ip -t mangle -F "$_ta" 2>/dev/null
			$_ip -t mangle -X "$_ta" 2>/dev/null
		done
	done
	clean_pca_chains
}

prune_usage() {
	local _keep _cut
	_keep=$(pc_uget "@basic[0].usage_keep")
	case "$_keep" in ''|*[!0-9]*) _keep=90 ;; esac
	if [ "$_keep" -gt 0 ] 2>/dev/null; then
		find "$USAGE_DIR" -type f -mtime +"$_keep" -delete 2>/dev/null
		# 重置日志同样按保留天数裁剪（按行内日期过滤）；
		# date -d @epoch 若不被 busybox 支持，退化为按行数保留最近 2000 条（绝不“永不裁剪”）。
		if [ -f "$RESET_LOG" ]; then
			_cut=$(date -d "@$(( $(date +%s) - _keep * 86400 ))" +%Y-%m-%d 2>/dev/null)
			if [ -n "$_cut" ]; then
				awk -F'\t' -v cut="$_cut" '$1 >= cut' "$RESET_LOG" > "$RESET_LOG.new" 2>/dev/null && mv "$RESET_LOG.new" "$RESET_LOG"
			else
				tail -n 2000 "$RESET_LOG" > "$RESET_LOG.new" 2>/dev/null && mv "$RESET_LOG.new" "$RESET_LOG"
			fi
		fi
	fi
	return 0
}

# 池成员（"module[idx]" 列表）
pool_members() { # $1=池名 $2=school|holiday
	local _m _i
	for _m in $PC_MODULES; do
		for _i in $(pc_ids_on "$_m"); do
			[ "$(pc_entry_pool "$_m" "$_i" "$2")" = "$1" ] && echo "${_m}[${_i}]"
		done
	done
}

# 当前这一分钟内该条目产生的流量（KB）= 计数器当前值 - 上次采样基线
# 计数器 dump（v4+v6 一起），只让调用方 dump 一次再复用
dump_acct() { # $1=输出文件
	{
		$ipt -t mangle -nvx -L "$TAGA" 2>/dev/null
		$ipt6 -t mangle -nvx -L "$TAGA" 2>/dev/null
	} > "$1"
}

# 从 dump 文件里取某条目的累计字节数（$2 为空则现场 dump 一次）
acct_bytes() { # $1=key $2=dump文件
	local _f _v
	if [ -n "${2:-}" ]; then
		_f=$2
	else
		mkdir -p "$STATE_DIR"; _f="$STATE_DIR/acct.$$"; dump_acct "$_f"
	fi
	_v=$(awk -v t="PCA_$1" '$3==t{s+=$2} END{printf "%d", s+0}' "$_f")
	[ -n "${2:-}" ] || rm -f "$_f"
	echo "$_v"
}

# 当前这一分钟内该条目产生的流量（KB）= 计数器当前值 - 上次采样基线
quota_live_kb() { # $1=key $2=dump文件（空=现场 dump）
	local _v _b _d
	_v=$(acct_bytes "$1" "${2:-}")
	_b=0; [ -f "$STATE_DIR/base.$1" ] && _b=$(cat "$STATE_DIR/base.$1")
	_d=$(( _v - _b )); [ "$_d" -lt 0 ] && _d=$_v
	echo $(( _d / 1024 ))
}

# 清零一个条目的今日用量并把事件写进 $RESET_LOG（纯数据处理，不碰 iptables）。
# 回显重置前的已用分钟数。
reset_one() { # $1=key
	local _key _f _used
	_key="$1"
	_f=$(pc_usage_file)
	_used=$(pc_usage_get "$_key")
	mkdir -p "$(dirname "$RESET_LOG")"
	printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%d)" "$(date +%H:%M:%S)" "$_key" "$_used" >> "$RESET_LOG"
	# 抹掉今天的用量行（= 该条目今天已用清零）
	if [ -f "$_f" ]; then
		grep -v "^${_key} " "$_f" > "$_f.new" 2>/dev/null
		mv "$_f.new" "$_f"
	fi
	elog "reset_quota: $_key 重置（重置前已用 $_used 分钟）"
	echo "$_used"
}

# 重置某条目今天的额度（可对池：pool:<名字>；会记进 $RESET_LOG）
reset_quota() {
	local _arg _m _i _n _pname
	_arg="$1"
	[ -n "$_arg" ] || { elog "reset_quota: 缺参数"; return 1; }
	_n=0
	case "$_arg" in
	pool:*)
		_pname=${_arg#pool:}
		case "$_pname" in ''|*[!A-Za-z0-9_.-]*) elog "reset_quota: 非法池名"; return 1 ;; esac
		# 池：逐成员清数据，但只在最后重建一次封锁链（原先每个成员重建一次 = O(N²) 条 iptables）
		for _m in $PC_MODULES; do
			for _i in $(pc_ids_on "$_m"); do
				[ "$(pc_entry_pool "$_m" "$_i" "$(pc_today_type)")" = "$_pname" ] || continue
				reset_one "${_m}_${_i}" >/dev/null
				_n=$((_n + 1))
			done
		done ;;
	*)
		# 严格白名单：只允许 module_index（防注入）
		case "$_arg" in *[!a-z0-9_]*) elog "reset_quota: 非法 key $_arg"; return 1 ;; esac
		reset_one "$_arg" >/dev/null
		_n=1 ;;
	esac
	# 若条目正被额度封锁，立刻重建封锁链让它马上可用。
	# 必须在 tick 锁内：否则可能与 tick 的 -F 交错，把「放行局域网」的规则整条冲掉，
	# 正好制造出自锁事故（还会持续到下一分钟）。
	[ "$_n" -gt 0 ] || return 0
	if pc_uget "@basic[0].enabled" | grep -q '^1$'; then
		with_tick_lock build_quota_blocks
	fi
	return 0
}

# AI 辅助解析的 HTTP 转发：唯一实现在 common.sh 的 pc_http（D9），这里只做参数换位。
#   ai_http GET  <url> <infile|-> <outfile>   （GET 忽略 infile）
#   ai_http POST <url> <infile>   <outfile>
# exit 0 = HTTP 2xx（响应体已写入 outfile）；非 0 = 失败（可读原因已写入 outfile）。
ai_http() {
	pc_http "$1" "$2" "$4" "$3"
}

# 绑定健康 / 诊断用的「在网设备清单」（第 8 轮 R10/D18/ADR-021）。
# 每行：host <mac> <ip> <name> <online>（空格分隔；缺项以 - 占位）。
#   online=1 ⇔ 该 MAC 在 `ip neigh` 里且状态 ∈ {REACHABLE, STALE, DELAY, PROBE}
#            （FAILED / INCOMPLETE / 无状态一律算 0）
#   ip/name 由 DHCP 租约（$DHCP_LEASES）补齐；只在租约里的设备也列出（online=0）。
# 只读、不碰配置、不碰 iptables —— 页面拿它做「绑定设备是否在网」展示与一键重绑。
hosts_tsv() {
	local _lf _nf
	mkdir -p "$STATE_DIR"
	_lf="$STATE_DIR/leases.$$"
	_nf="$STATE_DIR/neigh.$$"
	cat "$DHCP_LEASES" 2>/dev/null > "$_lf"
	ip neigh show 2>/dev/null > "$_nf"
	awk -v lf="$_lf" '
		BEGIN {
			while ((getline line < lf) > 0) {
				n = split(line, a, /[ \t]+/)
				if (n < 4) continue
				k = tolower(a[2])
				if (k !~ /^[0-9a-f][0-9a-f:]+$/) continue
				if (!(k in seen_l)) { lorder[++ln] = k; seen_l[k] = 1 }
				lip[k] = a[3]
				if (a[4] != "" && a[4] != "*") lh[k] = a[4]
			}
		}
		{
			mac = ""; st = ""
			for (i = 1; i <= NF; i++) {
				if ($i == "lladdr") mac = $(i + 1)
				else if ($i ~ /^(REACHABLE|STALE|DELAY|PROBE|FAILED|INCOMPLETE|PERMANENT|NOARP|NONE)$/) st = $i
			}
			if (mac == "") next
			k = tolower(mac)
			o = (st == "REACHABLE" || st == "STALE" || st == "DELAY" || st == "PROBE") ? 1 : 0
			if (!(k in seen_n)) {
				seen_n[k] = 1; norder[++nn] = k; macs[k] = k; nip[k] = $1; nonl[k] = o
			} else {
				if (o == 1 && nonl[k] == 0) nonl[k] = 1
				# 同一 MAC 先见 IPv6 邻居行、后见 IPv4 时，改报 IPv4（常用地址；v6 行不干扰 v4 结论）
				if (nip[k] ~ /:/ && $1 !~ /:/) nip[k] = $1
			}
		}
		END {
			for (i = 1; i <= nn; i++) {
				k = norder[i]
				printf "host %s %s %s %d\n", macs[k], (nip[k] != "" ? nip[k] : "-"), (lh[k] != "" ? lh[k] : "-"), nonl[k]
			}
			for (i = 1; i <= ln; i++) {
				k = lorder[i]
				if (k in seen_n) continue
				printf "host %s %s %s %d\n", k, (lip[k] != "" ? lip[k] : "-"), (lh[k] != "" ? lh[k] : "-"), 0
			}
		}' "$_nf"
	rm -f "$_lf" "$_nf"
	return 0
}

# 看板/列表数据：结构化 TSV（Lua 侧解析；不在 shell 里手拼 JSON）。
# 列定义同时写在 luasrc/model/cbi/parentcontrol/tsv.lua（唯一解析器），改列必须两边一起改。
#   stats_tsv brief  只输出 meta + entry（列表页够用，跳过历史/池/重置/计数器）
#   meta     <日期> <school|holiday> <阈值KB> <保留天> <当前HH:MM>
#   entry    <key> <module> <idx> <备注> <mac> <额度> <已用> <池> <本分钟KB> <不限额度>
#   pool     <池名> <额度|空=不限> <已用> <成员,逗号分隔>
#   hist     <YYYYMMDD> <当天总分钟>
#   histkey  <YYYYMMDD> <条目key> <分钟>
#   reset    <YYYYMMDD> <HH:MM:SS> <条目key> <重置前已用分钟>
stats_tsv() { pc_uci_snap_begin; stats_tsv_inner "$@"; pc_uci_snap_drop; }

stats_tsv_inner() {
	local _brief _tt _min_kb _keep _m _i _key _name _mac _q _u _pool _live _f _t _n _dump _unl _dd _hs _dtf _df _di _dname _donl _k _snap
	_brief="${1:-}"
	_tt=$(pc_today_type)
	_min_kb=$(pc_uget "@basic[0].usage_min_kb")
	case "$_min_kb" in ''|*[!0-9]*) _min_kb=8 ;; esac
	_keep=$(pc_uget "@basic[0].usage_keep")
	case "$_keep" in ''|*[!0-9]*) _keep=90 ;; esac
	printf 'meta\t%s\t%s\t%s\t%s\t%s\n' \
		"$(pc_today)" "$_tt" "$_min_kb" "$_keep" "$(date +%H:%M)"
	# 计数器 dump 只做一次：逐条目各起 2 个 iptables 会让弱路由器打开页面卡几秒
	if [ "$_brief" != "brief" ]; then
		mkdir -p "$STATE_DIR"; _dump="$STATE_DIR/acct.stats.$$"; dump_acct "$_dump"
	fi
	# 所有「已启用」条目（看板需要完整信息）
	for _m in $PC_MODULES; do
		for _i in $(pc_ids_on "$_m"); do
			_key="${_m}_${_i}"
			_name=$(pc_uget "@$_m[$_i].remarks" | tr -d '\t\r\n')
			_unl=$(pc_entry_unlimited "$_m" "$_i" "$_tt")
			# 第 5 字段 = 该条目绑定的全部 MAC（逗号+空格连接，A94/A111）；printf 参数个数/顺序不变
			# A111（§11.25.2 / F-3）：原先借外部行拼接命令，设备上缺失（rc=127）⇒ 字段恒空。
			_mac=$(pc_clients_macs "$_m" "$_i" | pc_join_comma)
			_q=0; _u=0; _pool=""
			set -- $(entry_effective "$_m" "$_i" "$_tt")   # $1=额度 $2=已用 $3=池名
			_q=$1; _u=$2; _pool=${3:-}
			_live=0
			[ -z "$_dump" ] || _live=$(quota_live_kb "$_key" "$_dump")
			printf 'entry\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$_key" "$_m" "$_i" "$_name" "$_mac" "$_q" "$_u" "$_pool" "$_live" "$_unl"
		done
	done
	if [ "$_brief" != "brief" ]; then
		# A50/D34 name 行：展示名「一份权威名单」（on/off/gone 三态），Lua 侧永不回退裸 key。
		#   name <key> <display> <state>；on=启用中 off=配置在但未启用 gone=配置已无（近 30 天出现过）
		# 集合 = on ∪ off ∪ gone；gone = 近 30 天 histkey/reset 出现过 − 配置里存在。
		# gone 的 display：diag c 行第 9 字段快照（单次 awk 汇总全部 diag 文件，不逐文件启 shell）
		# → 无快照退「条目 #<idx+1>」（key 形如 <module>_<idx>；解析失败退「条目 #?」）。
		for _m in $PC_MODULES; do
			for _i in $(pc_ids_all "$_m"); do
				_key="${_m}_${_i}"
				if pc_ids_on "$_m" | grep -qx "$_i"; then _st=on; else _st=off; fi
				_dname=$(entry_disp_name "$_key")
				printf 'name\t%s\t%s\t%s\n' "$_key" "$_dname" "$_st"
			done
		done
		# gone 集合与快照：单次 awk 汇总（近 30 天 histkey/reset − 配置存在的 key）。
		# R11-129：用量文件是「空格分隔 <key> <分钟>」（pc_usage_add），与 TAB 的
		# histkey/reset 不同 —— 这里用默认分隔符（空白）收集；maxdepth 1 进不了
		# diag/ 子目录，护栏 $1 != "diag" 双保险。
		{
			for _m in $PC_MODULES; do
				for _i in $(pc_ids_all "$_m"); do printf '%s\t%s\n' "${_m}_${_i}" 1; done
			done
			# A56（review11 Low-3）：取最近 30 天，必须排序（find 输出顺序不保证）；
			# 与 :1341/:1377 的 ls -1 风格一致。
			# A72/D44：本组三处 awk 末尾各补 /dev/null —— find 空 ⇒ awk 无文件实参改读
			# stdin，继承到不 EOF 的 fd（LuCI/ucode、daemon）会让 stats_tsv 永久挂死。
			awk '$1 != "diag" { n[$1]=1 } END { for (k in n) print k }' \
				$(find "$USAGE_DIR" -maxdepth 1 -type f -name '????????' 2>/dev/null | sort | tail -30) /dev/null
			# A54（review11 Major-1）：diag 文件契约 $2 = entry_key（$3 是 MAC/target，
			# 取错会把 MAC/域名写进权威名单 → gone 行 key 位冒出 MAC/域名）。
			awk -F'\t' 'NF >= 4 { n[$2]=1 } END { for (k in n) print k }' \
				$(find "$USAGE_DIR" -maxdepth 2 -path '*diag/????????' -type f 2>/dev/null | sort | tail -30) /dev/null
			# R11-129：重置日志的 key 集合并入下面的 reset 行流（stats_tsv 末段把
			# reset 事件按 TAB 行输出，gone 收集器直接吃它的 $3），不再单独 tail 一份。
			awk -F'\t' 'NF >= 4 && $1 ~ /^[0-9]{4}-/ { key=$3; n[key]=1 } END { for (k in n) print k }' "$RESET_LOG" 2>/dev/null
			awk -F'\t' '$1 == "c" && $9 != "" && !($2 in s) { s[$2]=$9 } END { for (k in s) print "snap:" k "\t" s[k] }' \
				$(find "$USAGE_DIR" -maxdepth 2 -path '*diag/????????' -type f 2>/dev/null | sort | tail -30) /dev/null
		} | awk -F'\t' '
			NF == 1 { seen[$1]=1; next }
			{ gots[$1]=$2; next }
			END {
				for (k in seen) {
					if (gots[k] != "") continue   # 配置里存在（on/off 已在上面输出）
					nm = gots["snap:" k] ""
					if (nm == "") { _di = k; sub(/^[a-z]+_/, "", _di); nm = (_di ~ /^[0-9]+$/) ? "条目 #" _di + 1 : "条目 #?" }
					printf "name\t%s\t%s\tgone\n", k, nm
				}
			}'
		# 共享池
		for _i in $(pc_ids_all quota); do
			_n=$(pc_uget "@quota[$_i].name"); [ -n "$_n" ] || continue
			_q=$(pc_pool_quota "$_n" "$_tt")   # 原样输出：空串 = 不限（pc_quota_positive 会把空压成 0=全禁，信息丢失）
			_u=$(pool_usage "$_n" "$_tt")
			printf 'pool\t%s\t%s\t%s\t%s\n' "$_n" "$_q" "$_u" \
				"$(pool_members "$_n" "$_tt" | tr '\n' ',' | sed 's/,$//')"
		done
		# 历史（最近 30 天）。第 8 轮起 $USAGE_DIR 下多了 diag/ 子目录（诊断明细），
		# 它不是用量文件，不能进 hist 统计。
		for _f in $(ls -1 "$USAGE_DIR" 2>/dev/null | grep -v '^diag$' | tail -30); do
			_t=$(awk '{s+=$2} END{printf "%d", s+0}' "$USAGE_DIR/$_f" 2>/dev/null)
			printf 'hist\t%s\t%s\n' "$_f" "$_t"
			awk -v d="$_f" '{s[$1]+=$2} END{for(k in s) printf "histkey\t%s\t%s\t%d\n", d, k, s[k]}' "$USAGE_DIR/$_f" 2>/dev/null
		done
		# 重置记录：reset <YYYYMMDD> <HH:MM:SS> <key> <重置前已用分钟>
		# 取最近 2000 条事件（与写日志侧 reset_quota 的 tail -n 2000 保留上限对齐，见 RESET_LOG 注释），
		# 30 天窗口由 Lua 侧按日期过滤（shell 不做日期算术）。
		if [ -f "$RESET_LOG" ]; then
			tail -n 2000 "$RESET_LOG" 2>/dev/null | awk -F'\t' 'NF >= 4 {gsub(/-/,"",$1); printf "reset\t%s\t%s\t%s\t%s\n", $1, $2, $3, $4}'
		fi
		# 诊断明细（第 8 轮 R13/D19）：
		#   diag    <entry_key> <name> <mac> <ip> <hostname> <online> <today_minutes> <first> <last>
		#   diagtgt <entry_key> <target> <today_minutes>
		#   diagday <YYYYMMDD> <entry_key> <mac> <minutes>
		# 30 天窗口由 Lua 侧按日期过滤/补零（shell 不做日期算术，与 hist 同惯例）。
		_dd="$USAGE_DIR/diag"
		if [ -d "$_dd" ]; then
			_hs="$STATE_DIR/hosts.stats.$$"
			hosts_tsv > "$_hs" 2>/dev/null
			_dtf="$_dd/$(pc_today | tr -d '-')"
			if [ -f "$_dtf" ]; then
				while IFS="$TAB" read -r _k _key _mac _ip _hn _min _first _last _snap; do
					[ "$_k" = "c" ] || continue
					_di=${_key#*_}
					# D31/A44 三档回退：① live ② 行内第 9 字段快照（条目已删除时唯一来源；旧 8 字段文件为空）③ 条目 #N；绝不裸 key
					_dname=$(entry_disp_name "$_key")
					[ -n "$_dname" ] || _dname=$_snap
					[ -n "$_dname" ] || _dname="条目 #$((_di + 1))"
					_donl=$(awk -v m="$_mac" '$1 == "host" && $2 == m { print $5; exit }' "$_hs" 2>/dev/null)
					case "$_donl" in 1) ;; *) _donl=0 ;; esac
					printf 'diag\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
						"$_key" "$_dname" "$_mac" "$_ip" "$_hn" "$_donl" "$_min" "$_first" "$_last"
				done < "$_dtf"
				awk -F'\t' '$1 == "t" { printf "diagtgt\t%s\t%s\t%s\n", $2, $3, $4 }' "$_dtf"
			fi
			for _df in $(ls -1 "$_dd" 2>/dev/null | tail -30); do
				[ -f "$_dd/$_df" ] || continue
				awk -F'\t' -v d="$_df" '
					$1 == "c" { s[$2 SUBSEP $3] += $6 }
					END { for (k in s) { split(k, kv, SUBSEP); printf "diagday\t%s\t%s\t%s\t%d\n", d, kv[1], kv[2], s[k] } }' \
					"$_dd/$_df"
			done
			rm -f "$_hs"
		fi
		[ -n "$_dump" ] && rm -f "$_dump"
	fi
	return 0
}

with_tick_lock() {
	mkdir "$TICK_LOCK" 2>/dev/null || {
		[ -n "$(find "$TICK_LOCK" -mmin +"$PC_LOCK_STALE_MIN" 2>/dev/null)" ] || return 0
		rm -rf "$TICK_LOCK"
		mkdir "$TICK_LOCK" 2>/dev/null || return 0
	}
	"$@"
	rmdir "$TICK_LOCK" 2>/dev/null
	return 0
}

# A24/D17：与 with_tick_lock 同逻辑，唯一差别是拿不到锁返回非 0（ensure 用它登记待办）。
# 必须共用 PC_LOCK_STALE_MIN（阈值唯一来源），否则 ensure 与 tick 的陈旧接管会分叉（R12）。
try_tick_lock() {
	mkdir "$TICK_LOCK" 2>/dev/null || {
		[ -n "$(find "$TICK_LOCK" -mmin +"$PC_LOCK_STALE_MIN" 2>/dev/null)" ] || return 1
		rm -rf "$TICK_LOCK"
		mkdir "$TICK_LOCK" 2>/dev/null || return 1
	}
	"$@"
	rmdir "$TICK_LOCK" 2>/dev/null
	return 0
}

# A70/D43：三个只读入口开/关 uci 快照（热路径逐次 fork uci 是稳态 tick 的主要成本）。
# 用「begin … drop」顺序保证异常返回也不留 /tmp 残留；**不用 EXIT trap** —— 那会顶掉
# 测试套件的清理 trap（test/lib.sh 的 _t_cleanup），导致临时目录滞留。
tick() { pc_uci_snap_begin; with_tick_lock tick_body; pc_uci_snap_drop; }

# D28：设备上是否留有本插件的运行时痕迹 —— mangle 表存在任一 PARENTCONTROL_* 跳转，
# 或任一 PC[A-Z]*_ 自定义链（PCA_/PCAW_/PCAD_/PCDT_/PCDC_……「PCD 开头」曾漏过，正则必须 PC[A-Z]*_）。
# 只读探测：每协议族一次 -S；停用清理路径专用（绝不在探测前发 -D/-F/-X）。
pc_residual_on_device() {
	local _ip _snap
	for _ip in "$ipt" "$ipt6"; do
		[ -n "$_ip" ] || continue
		_snap=$($_ip -t mangle -S 2>/dev/null)
		printf '%s\n' "$_snap" | grep -qE '^-A PREROUTING .*-j PARENTCONTROL_' && return 0
		printf '%s\n' "$_snap" | grep -qE '^-N PC[A-Z]*_' && return 0
	done
	return 1
}

# D28：三条跳转（QUOTA/ACCT/DIAG）在 PREROUTING/mangle 是否齐备（v4 与 v6 都要）。
# A52/D35 语义收紧：不止判存在，还判「每族每 tag **恰好一条**」+「-S 输出顺序 Q→A→D」。
# 任一不满足 → 返回非 0（调用方 build_all 会先 pc_unhook_all 拆干净再整套重建）。
pc_hooks_present() {
	local _ip _snap _ta _q _a _d
	for _ip in "$ipt" "$ipt6"; do
		[ -n "$_ip" ] || continue
		_snap=$($_ip -t mangle -S 2>/dev/null)
		for _ta in "$TAGQ" "$TAGA" "$TAGD"; do
			[ "$(printf '%s\n' "$_snap" | grep -cE "^-A PREROUTING .*-j $_ta( |$)")" = "1" ] || return 1
		done
		# 顺序：-S 是内核实际顺序；QUOTA 必须先于 ACCT 与 DIAG 出现（行号比较）
		_q=$(printf '%s\n' "$_snap" | grep -nE "^-A PREROUTING .*-j $TAGQ( |$)" | cut -d: -f1)
		_a=$(printf '%s\n' "$_snap" | grep -nE "^-A PREROUTING .*-j $TAGA( |$)" | cut -d: -f1)
		_d=$(printf '%s\n' "$_snap" | grep -nE "^-A PREROUTING .*-j $TAGD( |$)" | cut -d: -f1)
		[ -n "$_q" ] && [ -n "$_a" ] && [ -n "$_d" ] || return 1
		[ "$_q" -lt "$_a" ] 2>/dev/null && [ "$_a" -lt "$_d" ] 2>/dev/null || return 1
	done
	return 0
}

# A51/D35：三条跳转的「删到删不动」拆除（两族 × 三 tag）。外部注入的重复跳转
# （插件自身靠 hook_chain 的 -C 不会产生）也能一次 tick 收敛，而不是每 tick 删一条。
pc_unhook_all() {
	local _ip _ta
	for _ip in "$ipt" "$ipt6"; do
		[ -n "$_ip" ] || continue
		for _ta in "$TAGQ" "$TAGA" "$TAGD"; do
			while $_ip -t mangle -C PREROUTING -j "$_ta" 2>/dev/null; do
				$_ip -t mangle -D PREROUTING -j "$_ta" 2>/dev/null || break
			done
		done
	done
}

# 单族（$1 = 该族的 iptables 命令，ipt 或 ipt6）的删除循环；del_rule 逐族调用。
pc_unhook_all_family() {
	local _ip1 _ta
	_ip1="$1"
	[ -n "$_ip1" ] || return 0
	for _ta in "$TAGQ" "$TAGA" "$TAGD"; do
		while $_ip1 -t mangle -C PREROUTING -j "$_ta" 2>/dev/null; do
			$_ip1 -t mangle -D PREROUTING -j "$_ta" 2>/dev/null || break
		done
	done
}

tick_body() {
	local _tt
	# A25（O-8）：回收 /tmp/parentcontrol-uci.<pid> 的死进程残留快照。放在最前 —— 此时
	# with_tick_lock 已持锁，且本函数内不建快照，删不到正在用的那份。
	pc_uci_snap_gc
	[ -n "$ipt" ] || return 0
	# 正在 start（重建全套规则）时跳过，避免并发
	# A114（design §11.25.2 / F-4）：陈旧 $LOCK 兜底 —— 若 start/restart 中途被杀（OOM、
	# 拔电、脚本被 kill），旧实现会永久静默 return 0 ⇒ **tick 从此不再生效**（配额/时段
	# 封堵全部停摆，页面无任何异常提示）。现：锁龄 > $PC_LOCK_STALE_MIN min（阈值唯一来源是
	# common.sh 的 PC_LOCK_STALE_MIN，与 start() 共用；正常 restart 实测 12.1s）⇒ 判为陈旧、
	# 回收并 elog，然后继续本次 tick；< $PC_LOCK_STALE_MIN min 仍在正常 start 窗口 ⇒ 静默 return 0。
	if [ -f "$LOCK" ]; then
		if [ -n "$(find "$LOCK" -mmin +"$PC_LOCK_STALE_MIN" 2>/dev/null)" ]; then
			elog "stale lock $LOCK (age>${PC_LOCK_STALE_MIN}min) reclaimed"
			rm -f "$LOCK"
		else
			return 0
		fi
	fi
	if ! pc_uget "@basic[0].enabled" | grep -q '^1$'; then
		# D32/A45 停用：每 tick **无条件**只读探测（≤2 次 -S；写侧无 nft/conntrack 调用）——旧实现用
		# [ -e "$STATE_DIR" ] 当门槛，「规则在但状态目录被删」会永不清理（死角）。
		# 有残留 → del_rule → 复验，仍残留则 elog（下个 tick 重试）；两种情况都清状态目录。
		if pc_residual_on_device; then
			del_rule
			pc_residual_on_device && elog "停用清理未彻底（仍有残留），下个 tick 重试"
		fi
		# A23/D15：恢复动作挂「已停用」这个必然项，不挂「有残留」这个可选项（review2 B1）。
		# 停用只改 uci、不走 stop()；restore_offload 自带 nft 双守卫 + 幂等 + A7 静默 ⇒ 无条件安全。
		restore_offload
		rm -rf "$STATE_DIR"
		return 0
	fi
	mkdir -p "$STATE_DIR"
	# A116（design §11.25.2 / F-6）：清掉历史版本留下的 scratch 残渣（旧实现把 diag.t/c/ip 写在
	# 持久状态目录，进程被杀就永久遗留）。新实现已改到 /tmp 一次性目录，这里做一次垃圾回收，
	# 让「$STATE_DIR 只装持久状态」这一口径在升级后也立即成立。
	rm -f "$STATE_DIR"/diag.t.* "$STATE_DIR"/diag.c.* "$STATE_DIR"/diag.ip.* 2>/dev/null
	# A14-2/A26：同样回收签名草稿的孤儿（进程被杀时 build_quota_blocks 的 .cur.$$ 与
	# sync_offload 的 tmp.$$ 都会遗留）
	rm -f "$STATE_DIR"/offloadsig.cur.* "$STATE_DIR"/offloadsig.tmp.* 2>/dev/null
	# D28/A35 启用但三条跳转缺任一（fw4 reload / 上次 stop 后只靠 cron 的路径）：
	# build_all 整套重建 —— 它自带 ensure_chain 先建后挂 D→A→Q（最终 Q→A→D），
	# 与 restart/start 同路径（幂等，可反复跑）。
	if ! pc_hooks_present; then
		build_all
		return 0
	fi
	_tt=$(pc_today_type)
	if [ "$(cat "$STATE_DIR/daytype" 2>/dev/null)" != "$_tt" ]; then
		# 跨天 / 日子类型变化 → 生效档案变了，整套静态规则重建
		refresh_holiday
		refresh_ips
		build_all
	else
		sample_counters
		build_quota_blocks
		build_diag_blocks
		# A24：ensure 被锁跳过时留下的待办 —— 由本 tick 兑现（≤60 s）。稳态成本 = 一次 [ -f ]。
		if [ -f "$STATE_DIR/offload_pending" ]; then
			sync_offload
			rm -f "$STATE_DIR/offload_pending"
		fi
	fi
}

refresh_ip() { pc_uci_snap_begin; refresh_ip_inner; pc_uci_snap_drop; }

refresh_ip_inner() {
	pc_uget "@basic[0].enabled" | grep -q '^1$' || return 0
	[ -n "$ipt" ] || return 0
	with_tick_lock refresh_ip_body
}

# 只重建依赖 IP 解析结果的 mangle 链（网址时段/计数/额度封锁）。
# 注意：fw4 reload 会清掉这些链与 PREROUTING 跳转，所以必须 ensure/hook，
# 否则 cron 路径会静默失效（直到下次 restart 或跨天重建）。
# F-R5-3：TAGD 同样要 ensure + hook（此前缺了它，fw4 reload 后诊断链跳转丢失，
# cron 也补不回来）；链一律先 ensure 再 hook，hook 顺序 D→A→Q（-I 头插 ⇒ Q→A→D）。
rebuild_ip_rules() {
	local _tt _ip
	_tt=$(pc_today_type)
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGA"
		ensure_chain "$_ip" mangle "$TAGQ"
		ensure_chain "$_ip" mangle "$TAGD"
		hook_chain "$_ip" mangle PREROUTING "$TAGD"
		hook_chain "$_ip" mangle PREROUTING "$TAGA"
		hook_chain "$_ip" mangle PREROUTING "$TAGQ"
	done
	build_acct_rules "$_tt"
	build_quota_blocks
	build_diag_blocks
}

# cron 每 ip_refresh 分钟：采样后重解析域名、重建 IP 相关规则。
# 不重建 filter 表；refresh_holiday 自带节流（7 天/24h）、只写数据不建规则，
# 必须保留——长假期间 holiday→holiday 不触发跨天重建，否则节假日数据永不联网刷新。
refresh_ip_body() {
	refresh_holiday
	refresh_ips
	rebuild_ip_rules
}

cron_sync() { # $1=1 写入 / $1=0 移除
	local _mins new
	_mins=$(pc_uget "@basic[0].ip_refresh"); [ -z "$_mins" ] && _mins=30
	new=$(crontab -l 2>/dev/null | grep -v "$CRON_TAG" | grep -v "$CRON_TAG_IP")
	if [ "$1" = "1" ]; then
		new="$new
* * * * * /etc/init.d/parentcontrol tick >/dev/null 2>&1 $CRON_TAG"
		if [ "$_mins" -gt 0 ] 2>/dev/null; then
			new="$new
*/$_mins * * * * /etc/init.d/parentcontrol refresh_ip >/dev/null 2>&1 $CRON_TAG_IP"
		fi
	fi
	printf '%s\n' "$new" | grep -v '^$' | crontab -
	/etc/init.d/cron reload >/dev/null 2>&1
}

start() {
	[ -f "$LOCK" ] && {
		[ -n "$(find "$LOCK" -mmin +"$PC_LOCK_STALE_MIN" 2>/dev/null)" ] || exit 1
		elog "removing stale lock $LOCK"
	}
	# A23-2/D15：停用态下 start 必须是纯 no-op —— enabled 检查必须在 del_rule **之前**，
	# 否则「停用 + start」会拆链却不再重建，留下「无残留 + flow add 已删」这个 B1 入口。
	pc_uget "@basic[0].enabled" | grep -q '^1$' || exit 1
	del_rule
	[ -n "$ipt" ] || exit 1
	touch "$LOCK"
	trap 'rm -f "$LOCK"' EXIT INT TERM
	mkdir -p "$STATE_DIR" "$USAGE_DIR"
	refresh_holiday novet
	refresh_ips
	build_all
	cron_sync 1
	prune_usage
	clean_log
	rm -f "$LOCK" 2>/dev/null
}

stop() {
	del_rule
	# A6/D6：offload 决策点从 del_rule 移到这里 —— del_rule 有两个语义完全不同的
	# 调用方（stop=真拆除，应该恢复；start=重建，不该中途恢复）。不移走就是
	# 日志里每天几十对「restored → disabled」翻转（RC-3）。
	restore_offload
	cron_sync 0
	rm -f "$LOCK" 2>/dev/null
	rm -rf "$STATE_DIR" 2>/dev/null
}

reload() { stop; start; }

# A8/D7：接口事件（ifup/ifupdate）的**轻量**入口，供 /etc/hotplug.d/iface/97-parentcontrol 调。
# 为什么不用 start：start 的第一件事是 del_rule（三链 -F + -X、摘掉 PREROUTING 跳转），
# 之后才 refresh_ips（含 DNS 解析，慢）→ build_all 重建。真机实测两次日志时间戳差
# 15~26 秒，这段窗口里封锁链不在（该封的没封）、计数链不在（漏计时）。
# 而接口事件的真实需求只有一条：**fw4 重载可能清空了我们的 mangle 链，补齐**。
# 硬约束：不取/不写 $LOCK、不 del_rule、不 refresh_ips、不 cron_sync、不 prune_usage、不 clean_log。
ensure() {
	pc_uget "@basic[0].enabled" | grep -q '^1$' || exit 0
	# A15/M3：与 tick 并发会同时写 mangle（共享 offloadsig.cur 会互相截断）。
	# A24/D11：拿不到 TICK_LOCK 不再静默跳过 —— 登记 offload_pending，由下一个 tick（≤60 s）的
	# 稳态分支补偿 sync_offload（旧 D11 不成立：稳态 tick 不调 sync_offload ⇒ 被跳过的 purge 无限期
	# 挂起，review2 M1）。链被 fw4 reload 清空仍由 D28 兜住；$LOCK 与 TICK_LOCK 是两个锁。
	if pc_hooks_present; then
		try_tick_lock _ensure_light || _mark_offload_pending
	else
		try_tick_lock _ensure_full || _mark_offload_pending
	fi
}
# A24：ensure 被锁跳过时的待办登记（零成本标记文件），由 tick 稳态分支兑现。
_mark_offload_pending() { mkdir -p "$STATE_DIR"; : > "$STATE_DIR/offload_pending"; }
# A8/A9：hooks 齐备时只跑「自带 spec+条数双重门控」的封锁链重建（链被外部清空时只有它
# 能发现）与 offload 状态同步（签名门控 ⇒ 稳态零 purge）。
_ensure_light() { build_quota_blocks; sync_offload; }
# 链或跳转被拆（fw4 reload / 外部清理）→ 为保命走全量重建（不取 $LOCK）。
_ensure_full() { build_all; }
