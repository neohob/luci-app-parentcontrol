#!/bin/sh /etc/rc.common
# 本 fork 新增：每日额度 / 平日-节假日双档案 / 共享额度池 / 节假日数据
# 设计说明见 README；纯逻辑（日子判定、额度、用量）在 /usr/lib/parentcontrol/common.sh

DIR="$(cd "$(dirname "$0")" && pwd)"
START=98

# “今天 / 重置点 / 额度”一律按北京时间（UTC+8）计算，与路由器系统时区无关。
# 用 POSIX TZ 字串，不依赖 zoneinfo 文件。
TZ=UTC-8
export TZ

PC_CONF=parentcontrol
CONFIG=$PC_CONF
LOG_FILE=${LOG_FILE:-/tmp/log/$CONFIG.log}
LOCK=${LOCK:-/tmp/lock/${CONFIG}.lock}
TICK_LOCK=${TICK_LOCK:-/tmp/lock/${CONFIG}.tick}
ipt=$(command -v iptables-legacy || command -v iptables)
ipt6=$(command -v ip6tables-legacy || command -v ip6tables)

# 统一后只剩两条链（都在 mangle PREROUTING，顺序 TAGQ → TAGA）：
#   TAGQ 额度/时段封锁、TAGA 用量计数。老版本的 PARENTCONTROL_TIME/PROTOCOL/WEBURL/IP
#   已废弃，只在 del_rule 里按字面量清理一次。
TAGA="PARENTCONTROL_ACCT"
TAGQ="PARENTCONTROL_QUOTA"
FWI="/var/etc/$CONFIG.include"
IPDIR=${IPDIR:-/etc/parentcontrol/ips}
USAGE_DIR=${USAGE_DIR:-/etc/parentcontrol/usage}
HOLIDAY_CACHE=${HOLIDAY_CACHE:-/etc/parentcontrol/holiday}
HOLIDAY_LOCAL=${HOLIDAY_LOCAL:-/usr/share/parentcontrol/holiday}
STATE_DIR=${STATE_DIR:-/tmp/parentcontrol}
# 重置日志放 /etc（flash）是有意的：重置历史要跨重启保留，不能放 /tmp。
RESET_LOG=${RESET_LOG:-/etc/parentcontrol/resets.log}
CRON_TAG="#pc_tick"
CRON_TAG_IP="#pc_ip_refresh"

. "${PC_LIB:-/usr/lib/parentcontrol/common.sh}"

EXTRA_COMMANDS="tick refresh_ip refresh_holiday stats_tsv reset_quota"
EXTRA_HELP="
	tick             Re-evaluate quota state and account usage (cron, every minute)
	refresh_ip       Re-resolve domains and rebuild IP rules (cron)
	refresh_holiday  Fetch statutory-holiday data for this year and next
	stats_tsv [brief]  Print dashboard/list data as TSV (brief: meta+entry only)
	stats_tsv        Print full stats for the dashboard as TSV
	reset_quota      Reset an entry's (or pool's) quota for today; logged to /etc/parentcontrol/resets.log"

elog() {
	echo "$(date '+%Y-%m-%d %H:%M:%S'): $*" >>$LOG_FILE
}

clean_log() {
	[ "$(cat $LOG_FILE 2>/dev/null | wc -l)" -gt 500 ] && : > "$LOG_FILE"
}

# ============================================================================
# 小工具
# ============================================================================
ensure_chain() { # $1=ipcmd $2=table $3=chain
	$1 -t $2 -N $3 2>/dev/null || $1 -t $2 -F $3 2>/dev/null
}
hook_chain() { # $1=ipcmd $2=table $3=parent $4=chain
	$1 -t $2 -C $3 -j $4 2>/dev/null || $1 -t $2 -I $3 -j $4 2>/dev/null
}
entry_key() { echo "$1_$2"; }

# 计数用的“设备条件”：ip 优先（避免 mac+ip 双计），都没有=全部客户端
devcount() {
	local _ip _mac
	_ip=$(pc_uget "@$1[$2].ip")
	_mac=$(pc_uget "@$1[$2].mac")
	if [ -n "$_ip" ]; then echo "-s $_ip"
	elif [ -n "$_mac" ]; then echo "-m mac --mac-source $_mac"
	fi
}

# 封锁/时段用：对条目的每个设备身份各加一条规则（mac 与 ip 任一命中即生效）
add_dev_rules() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action
	local _mac _ip _n
	_mac=$(pc_uget "@$4[$5].mac")
	_ip=$(pc_uget "@$4[$5].ip")
	_n=0
	[ -n "$_mac" ] && { $1 -t $2 -I $3 -m mac --mac-source "$_mac" $6 $7 2>/dev/null; _n=1; }
	[ -n "$_ip" ]  && { $1 -t $2 -I $3 -s "$_ip" $6 $7 2>/dev/null; _n=1; }
	[ "$_n" = 0 ] && $1 -t $2 -I $3 $6 $7 2>/dev/null
	return 0
}

# 时段窗口（禁止时段）。起控=停控 或留空 → 无时间条件（= 全天封，沿用旧语义）

# 协议端口条件（单个用 --sport/--dport；多个/范围用 -m multiport）
proto_cond() { # $1=idx
	local _proto _ports _portd _cond
	_proto=$(pc_uget "@protocol[$1].proto"); [ -z "$_proto" ] && _proto=tcp
	_ports=$(pc_uget "@protocol[$1].ports")
	_portd=$(pc_uget "@protocol[$1].portd")
	_cond="-p $_proto"
	if [ -n "$_ports" ] && [ -n "$_portd" ]; then
		_cond="$_cond -m multiport --sports $_ports --dports $_portd"
	elif [ -n "$_portd" ]; then
		case "$_portd" in *,*|*:*) _cond="$_cond -m multiport --dports $_portd" ;; *) _cond="$_cond --dport $_portd" ;; esac
	elif [ -n "$_ports" ]; then
		case "$_ports" in *,*|*:*) _cond="$_cond -m multiport --sports $_ports" ;; *) _cond="$_cond --sport $_ports" ;; esac
	fi
	echo "$_cond"
}

# ============================================================================
# 域名解析 → 按条目存 IP 列表（IPv4 /24 或 /32，IPv6 /64，含 / 的按 CIDR 原样）
# ============================================================================
ip6_slash64() {
	echo "$1" | awk -F"::" '
		{
			if (NF == 2) {
				na = ($1 == "") ? 0 : split($1, a, ":")
				nb = ($2 == "") ? 0 : split($2, b, ":")
				n = 8 - na - nb
				out = $1
				for (i = 0; i < n; i++) out = out ":0"
				out = out ":" $2
			} else { out = $1 }
			sub(/^:/, "", out); sub(/:$/, "", out)
			split(out, p, ":")
			printf "%s:%s:%s:%s::/64\n", p[1], p[2], p[3], p[4]
		}'
}

entry_domains() { # $1=module $2=idx
	local _d
	_d=$(pc_uget "@$1[$2].domains")
	[ -z "$_d" ] && _d=$(pc_uget "@$1[$2].word")
	echo "$_d" | tr ',' ' '
}

resolve_host() { # $1=host → 打印 IPv4(/24 或 /32) 与 IPv6(/64)
	local _a
	for _a in $(resolveip -4 -t 2 "$1" 2>/dev/null); do
		echo "$_a" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || continue
		if [ "$PC_IPMASK" = "32" ]; then echo "$_a"; else echo "$(echo $_a | cut -d. -f1-3).0/24"; fi
	done
	for _a in $(resolveip -6 -t 2 "$1" 2>/dev/null); do
		echo "$_a" | grep -qE '^[0-9a-fA-F:]+$' || continue
		case "$_a" in *:*) ip6_slash64 "$_a" ;; esac
	done
}

resolve_entry() { # $1=module $2=idx
	local _h _hh
	for _h in $(entry_domains "$1" "$2"); do
		case "$_h" in
		*/*) echo "$_h" ;;   # 直接写 CIDR：不解析，原样使用
		*.*)
			resolve_host "$_h"
			case "$_h" in
			www.*) resolve_host "${_h#www.}" ;;
			*)     resolve_host "www.$_h" ;;
			esac ;;
		*)
			for _hh in "$_h" "$_h.com" "www.$_h.com" "$_h.cn"; do resolve_host "$_hh"; done ;;
		esac
	done
}

refresh_ips() {
	local _i _f _idx
	mkdir -p "$IPDIR"
	command -v resolveip >/dev/null 2>&1 || return 0
	PC_IPMASK=$(pc_uget "@basic[0].ip_mask"); [ -z "$PC_IPMASK" ] && PC_IPMASK=24
	for _i in $(pc_ids_on weburl); do
		_f="$IPDIR/weburl_$_i"
		{ resolve_entry weburl $_i; [ -f "$_f" ] && cat "$_f"; } 2>/dev/null \
			| grep -v '^$' | sort -u > "$_f.new"
		mv "$_f.new" "$_f"
	done
	for _f in "$IPDIR"/weburl_*; do
		[ -e "$_f" ] || continue
		_idx=${_f##*weburl_}
		pc_ids_on weburl | grep -qx "$_idx" || rm -f "$_f"
	done
	elog "refresh_ips: $(cat "$IPDIR"/* 2>/dev/null | wc -l) 条目标 IP"
}

# ============================================================================
# 节假日数据
# ============================================================================
fetch_url() { # $1=url $2=out
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 8 -O "$2" "$1"
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 8 -O "$2" "$1"
	elif command -v curl >/dev/null 2>&1; then
		curl -fsS --max-time 8 -o "$2" "$1"
	else
		return 1
	fi
}

refresh_holiday() { # [$1=force|novet]
	local _b _n _y _y2 _yy _f _stamp _u
	mkdir -p "$HOLIDAY_CACHE"
	for _b in "$HOLIDAY_LOCAL"/*.json; do
		[ -e "$_b" ] || continue
		_n="$HOLIDAY_CACHE/$(basename "$_b")"
		[ -f "$_n" ] || cp "$_b" "$_n"
	done
	# novet：只复制离线 bundle，不联网（用于开机，避免启动卡在网络上）
	[ "$1" = "novet" ] && return 0
	_y=$(date +%Y); _y2=$((_y + 1))
	for _yy in $_y $_y2; do
		_f="$HOLIDAY_CACHE/$_yy.json"
		_stamp="$HOLIDAY_CACHE/$_yy.stamp"
		if [ "$1" != "force" ]; then
			# 一天内不再重试，避免对着未发布的明年数据反复请求
			[ -f "$_stamp" ] && [ -z "$(find "$_stamp" -mmin +1440 2>/dev/null)" ] && continue
			# 已有 7 天内的有效数据
			[ -f "$_f" ] && grep -q '"date"' "$_f" 2>/dev/null && [ -z "$(find "$_f" -mtime +7 2>/dev/null)" ] && continue
		fi
		for _u in \
			"https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/$_yy.json" \
			"https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/$_yy.json"; do
			if fetch_url "$_u" "$_f.tmp" && grep -q '"date"' "$_f.tmp" 2>/dev/null; then
				mv "$_f.tmp" "$_f"
				elog "holiday: fetched $_yy"
				break
			fi
			rm -f "$_f.tmp"
		done
		touch "$_stamp" 2>/dev/null
	done
}

# ============================================================================
# flow-offload（沿用旧逻辑：有受管设备就不让任何流被卸载）
# ============================================================================
offload_macs() {
	pc_uget "@basic[0].enabled" | grep -q '^1$' || return 0
	weburl_macs_all
}
weburl_macs_all() {
	uci show "$PC_CONF" 2>/dev/null | grep 'weburl' | grep '\.mac=' \
		| sed -n "s/.*\.mac='\(.*\)'/\1/p" | sort -u
}
weburl_ips_all() {
	uci show "$PC_CONF" 2>/dev/null | grep 'weburl' | grep '\.ip=' \
		| sed -n "s/.*\.ip='\(.*\)'/\1/p" | sort -u
}
offload_handle() {
	nft -a list chain inet fw4 forward 2>/dev/null \
		| grep 'flow add @ft' | head -1 \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}
apply_offload() {
	local h n m a
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	if [ -n "$(offload_macs)$(weburl_ips_all)" ]; then
		if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
			h=$(offload_handle)
			[ -n "$h" ] && nft delete rule inet fw4 forward handle $h 2>/dev/null
			if nft list chain inet fw4 forward 2>/dev/null | grep -q 'flow add @ft'; then
				elog "offload: ERROR 删除 flow add 规则失败"
			else
				elog "offload: disabled"
			fi
		fi
		if command -v conntrack >/dev/null 2>&1; then
			n=0
			for m in $(offload_macs); do
				for a in $(ip neigh show 2>/dev/null | grep -i " $m " | awk '{print $1}'); do
					conntrack -D -s "$a" >/dev/null 2>&1 && n=$((n + 1))
				done
			done
			for a in $(weburl_ips_all); do
				conntrack -D -s "$a" >/dev/null 2>&1 && n=$((n + 1))
			done
			[ "$n" -gt 0 ] && elog "offload: purged conntrack for managed hosts"
		fi
		printf 'disabled\n' > /tmp/pc_offload_state
	fi
}
restore_offload() {
	local h
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	h=$(offload_handle)
	[ -n "$h" ] && nft delete rule inet fw4 forward handle $h 2>/dev/null
	nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
	printf 'on\n' > /tmp/pc_offload_state
	elog "offload: restored"
}

# ============================================================================
# 规则构建
# ============================================================================

# 在链顶插入「目标为局域网网段 → 直接放行」。路由器自身的管理地址就在局域网网段里，
# 所以这是防自锁的关键：无设备条件的条目（= 对全部客户端生效）一旦生成无条件
# DROP/REJECT，没有这条就会被管理员自己也一起封掉（实测踩过）。
# 注意必须在所有封锁规则插完之后再调用——-I 是插到链首。
# 本机没有 addrtype 模块，只能用「目标网段」放行，等价于放行到路由器自身的管理流量。
allow_lan_in() { # $1=ipcmd $2=table $3=chain
	local _n
	for _n in $(pc_lan_nets); do
		$1 -t $2 -I "$3" -d "$_n" -j RETURN 2>/dev/null
	done
	return 0
}



# 网址过滤匹配串（域名/关键词），逐包 -m string 用。
# 字符集有意不含 *：-m string 是字面匹配，* 不会被当通配符，加进来只会带出
# 无意义的规则并使命令拼接有 glob 风险（旧版为此保留了 set -f hack，已去掉）。
weburl_patterns() {
	# 单一来源：与解析目标 IP 用同一份 entry_domains（domains，缺省回退 word）。
	# 曾经这里是 word ∪ domains，会让改过域名后的旧 word 变成“幽灵匹配源”。
	entry_domains weburl "$1" | tr ' ' '\n' \
		| sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
		| grep -E '^[A-Za-z0-9._/-]+$' | sort -u
}

# 计数用：单一设备条件（ip 优先）加一条规则——避免 mac+ip 两条都被命中而双计
add_dev_rule_single() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action
	local _c
	_c=$(devcount "$4" "$5")
	$1 -t $2 -I $3 $_c $6 $7 2>/dev/null
	return 0
}

# 按 devmode 选“封锁式（mac/ip 各一条）”还是“计数式（ip 优先单条）”
emit_dev_rule() { # $1=ipcmd $2=table $3=chain $4=module $5=idx $6=extra $7=action $8=devmode
	if [ "$8" = "single" ]; then
		add_dev_rule_single "$1" "$2" "$3" "$4" "$5" "$6" "$7"
	else
		add_dev_rules "$1" "$2" "$3" "$4" "$5" "$6" "$7"
	fi
}

# 一个条目的全部目标规则——time / protocol / weburl 三类统一入口（封锁与计数共用）。
# $1=module $2=idx $3=IP链 $4=字符串链 $5=gate $6=动作 $7=devmode
emit_entry_targets() { # $1=module $2=idx $3=table $4=IP链 $5=字符串链 $6=gate $7=动作 $8=devmode
	local _pc
	case "$1" in
	time)
		emit_dev_rule "$ipt"  "$3" "$4" time "$2" "$6" "$7" "$8"
		emit_dev_rule "$ipt6" "$3" "$4" time "$2" "$6" "$7" "$8" ;;
	protocol)
		_pc=$(proto_cond "$2")
		emit_dev_rule "$ipt"  "$3" "$4" protocol "$2" "$6 $_pc" "$7" "$8"
		emit_dev_rule "$ipt6" "$3" "$4" protocol "$2" "$6 $_pc" "$7" "$8" ;;
	weburl)
		emit_weburl_targets "$3" "$4" "$5" "$6" "$7" "$2" "$8" ;;
	esac
}

# 一个 weburl 条目的全部目标规则（目标 IP + 明文 DNS/SNI 匹配串）。
# 时段封锁 / 额度封锁 / 额度计数 共用同一个生成器，保证三者枚举的目标集合永远一致。
# $6=devmode：all（默认，mac 与静态IP 各出一条，用于封锁）| single（ip 优先单条，用于计数）
emit_weburl_targets() { # $1=table $2=IP链 $3=字符串链 $4=gate $5=动作 $6=idx [$7=devmode]
	local _algos _f _p _pat _c _dev
	_dev=${7:-all}
	_algos=$(pc_uget "@basic[0].algos"); [ -z "$_algos" ] && _algos=kmp
	_f="$IPDIR/weburl_$6"
	[ -f "$_f" ] && while read -r _p; do
		[ -z "$_p" ] && continue
		case "$_p" in
		*:*) _c=$ipt6 ;;
		*)   _c=$ipt ;;
		esac
		emit_dev_rule "$_c" "$1" "$2" weburl "$6" "$4 -d $_p" "$5" "$_dev"
	done < "$_f"
	for _pat in $(weburl_patterns "$6"); do
		for _c in "$ipt" "$ipt6"; do
			emit_dev_rule "$_c" "$1" "$3" weburl "$6" "$4 -p UDP --dport 53 -m string --algo $_algos --string $_pat" "$5" "$_dev"
			emit_dev_rule "$_c" "$1" "$3" weburl "$6" "$4 -p TCP -m multiport --dports 80,443 -m string --algo $_algos --string $_pat" "$5" "$_dev"
		done
	done
}


clean_pca_chains() {
	local _c
	for _c in $($ipt -t mangle -S 2>/dev/null | sed -n 's/^-N \(PCA_[^ ]*\)$/\1/p'); do
		$ipt -t mangle -X "$_c" 2>/dev/null
	done
	for _c in $($ipt6 -t mangle -S 2>/dev/null | sed -n 's/^-N \(PCA_[^ ]*\)$/\1/p'); do
		$ipt6 -t mangle -X "$_c" 2>/dev/null
	done
}

# 额度模式：常开计数规则（跳进空链 PCA_<key>，读跳转规则的字节计数）
build_acct_rules() { # $1=school|holiday
	local _key _m _i _ip
	# 重建会清空计数器，所以「先采样再重建」必须在这里做：
	# 不变量属于这个函数，调用方（build_all / rebuild_ip_rules）无从违反。
	sample_counters
	for _ip in "$ipt" "$ipt6"; do $_ip -t mangle -F "$TAGA" 2>/dev/null; done
	clean_pca_chains
	for _key in $(pc_quota_keys "$1"); do
		_m=${_key%%_*}; _i=${_key#*_}
		ensure_chain "$ipt" mangle "PCA_$_key"
		ensure_chain "$ipt6" mangle "PCA_$_key"
		# 计数式：单一设备条件 + IP/字符串都计入
		emit_entry_targets "$_m" "$_i" mangle "$TAGA" "$TAGA" "" "-j PCA_$_key" single
	done
	# 不删 base.*：本函数开头已采样，保留基线才能把重建后那一分钟也计入
}

# 池内条目用量之和（只统计同样处于额度模式的成员）
pool_usage() { # $1=池名 $2=school|holiday
	local _key _m _i _sum
	_sum=0
	for _key in $(pc_quota_keys "$2"); do
		_m=${_key%%_*}; _i=${_key#*_}
		[ "$(pc_entry_pool "$_m" "$_i" "$2")" = "$1" ] || continue
		_sum=$((_sum + $(pc_usage_get "$_key")))
	done
	echo "$_sum"
}

# 把某条目封进 TAGQ（设备条件 × 目标）
block_entry() { # $1=module $2=idx
	emit_entry_targets "$1" "$2" mangle "$TAGQ" "$TAGQ" "" "-j DROP" all
}

# 条目生效的额度/已用：池优先；池不存在或没额度则用条目自己的。
# 输出 "<quota> <used>"（quota=0 表示不限）。封锁与看板共用，保证两者一致。
entry_effective() { # $1=module $2=idx $3=school|holiday
	local _pool _pq
	_pool=$(pc_entry_pool "$1" "$2" "$3")
	_pq=
	[ -n "$_pool" ] && _pq=$(pc_pool_quota "$_pool" "$3")
	# 输出「有效额度 已用 池名」——封锁链、看板、列表页共用同一份池优先解析
	if [ -n "$_pq" ]; then
		echo "$(pc_quota_positive "$_pq") $(pool_usage "$_pool" "$3") $_pool"
	else
		echo "$(pc_quota_positive "$(pc_entry_quota "$1" "$2" "$3")") $(pc_usage_get "$(entry_key "$1" "$2")") $_pool"
	fi
}

# 额度封锁链：① 可用时段之外 ② 额度耗尽（详见函数内注释）
# 可用时段之外的封锁规则（$3/$4 = UTC 秒区间；本机 iptables 不支持「! -m time」取反，
# 所以「时段外」一律用正向区间表达，跨 UTC 零点时由 pc_utc_ranges 切成两段）
block_entry_window() { # $1=module $2=idx $3=UTC起秒 $4=UTC止秒
	emit_entry_targets "$1" "$2" mangle "$TAGQ" "$TAGQ" \
		"-m time --timestart $(pc_sec_hhmmss "$3") --timestop $(pc_sec_hhmmss "$4")" "-j DROP" all
}

# 防自锁守卫：无设备条件（= 对全部客户端生效）且拿不到局域网网段时不能封锁 ——
# 无差别 PREROUTING DROP 会把路由器自己也封死。返回 0 表示"应当跳过这条"。
block_skip_devless() { # $1=module $2=idx $3=局域网网段列表
	[ -n "$(pc_uget "@$1[$2].mac")" ] && return 1
	[ -n "$(pc_uget "@$1[$2].ip")" ] && return 1
	[ -n "$3" ] && return 1
	elog "quota: $1[$2] 无设备条件且拿不到局域网网段，跳过封锁以防自锁"
	return 0
}

# 额度封锁链，三个来源互不干扰：
#   ⓪ 模式=全天禁止 → 无条件封（不看时段、不看额度）
#   ① 模式=每日额度 且不在可用时段内 → 封（内核 -m time 精确到秒，不依赖 tick）
#   ② 模式=每日额度 且额度用完 → 整条封（比时段封更强，所以不需要时间条件）
# 勾了「不限额度」的条目只受 ① 约束。
build_quota_blocks() {
	local _tt _key _m _i _ip _lan _a _b
	_tt=$(pc_today_type)
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGQ"
		$_ip -t mangle -F "$TAGQ" 2>/dev/null
	done
	_lan=$(pc_lan_nets)
	# ⓪ 全天禁止：无条件封（守卫必须在最前——它是最强的无条件 DROP）
	for _key in $(pc_quota_keys "$_tt" block); do
		_m=${_key%%_*}; _i=${_key#*_}
		block_skip_devless "$_m" "$_i" "$_lan" && continue
		block_entry "$_m" "$_i"
	done
	for _key in $(pc_quota_keys "$_tt"); do
		_m=${_key%%_*}; _i=${_key#*_}
		block_skip_devless "$_m" "$_i" "$_lan" && continue
		# ① 可用时段之外
		pc_qwin_out_ranges "$_m" "$_i" "$_tt" | while read -r _a _b; do
			[ -n "$_a" ] && block_entry_window "$_m" "$_i" "$_a" "$_b"
		done
		# ② 额度耗尽（勾了「不限额度」= 只看时段，不判额度）
		[ "$(pc_entry_unlimited "$_m" "$_i" "$_tt")" = "1" ] && continue
		set -- $(entry_effective "$_m" "$_i" "$_tt")
		[ "$1" -gt 0 ] 2>/dev/null || continue
		[ "$2" -ge "$1" ] && block_entry "$_m" "$_i"
	done
	# 最后插入「放行到局域网网段」的规则（含路由器自身 IP），SSH/LuCI 才不会被
	# 自己的封锁断掉。必须排在所有封锁规则之前，而 -I 是插到最前，故放在最后插入。
	for _ip in "$ipt" "$ipt6"; do
		allow_lan_in "$_ip" mangle "$TAGQ"
	done
}

# 额度计数链名（供 sample 读取）
active_acct_keys() {
	pc_quota_keys "$(pc_today_type)"
}

# ============================================================================
# 用量采样：每分钟对比计数增量，超阈值记 1 分钟
# ============================================================================
sample_counters() {
	local _min_kb _thr _dump _key _v _bf _b _d _k
	mkdir -p "$STATE_DIR"
	_min_kb=$(pc_uget "@basic[0].usage_min_kb")
	case "$_min_kb" in ''|*[!0-9]*) _min_kb=8 ;; esac
	_thr=$((_min_kb * 1024))
	_dump="$STATE_DIR/acct.sample.$$"; dump_acct "$_dump"
	for _key in $(active_acct_keys); do
		_v=$(acct_bytes "$_key" "$_dump")
		_bf="$STATE_DIR/base.$_key"
		if [ -f "$_bf" ]; then
			_b=$(cat "$_bf")
			if [ "$_v" -ge "$_b" ]; then _d=$((_v - _b)); else _d=$_v; fi
		else
			# 首次采样（开机/重建后）：计数器当前值就是“自规则建立以来”的流量，
			# 直接按它判一次，否则这段时间的用量会被白白丢掉。
			_d=$_v
		fi
		# 必须有实际流量（_d>0）且达到阈值才记，否则阈值 0 时零流量也会记一分钟
		[ "$_d" -gt 0 ] && [ "$_d" -ge "$_thr" ] && pc_usage_add "$_key" 1
		echo "$_v" > "$_bf"
	done
	rm -f "$_dump"
	for _bf in "$STATE_DIR"/base.*; do
		[ -e "$_bf" ] || continue
		_k=${_bf##*/base.}
		active_acct_keys | grep -qx "$_k" || rm -f "$_bf"
	done
}

# ============================================================================
# 生命周期
# ============================================================================
build_all() {
	local _tt _ip
	_tt=$(pc_today_type)
	elog "build: day=$_tt"
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGA"; $_ip -t mangle -F "$TAGA" 2>/dev/null
		ensure_chain "$_ip" mangle "$TAGQ"; $_ip -t mangle -F "$TAGQ" 2>/dev/null
	done
	build_acct_rules "$_tt"
	# PREROUTING 顺序必须是 TAGQ → TAGA（被封的包不再进计数链）。
	# hook_chain 用 -I 插到链首，所以先挂 TAGA、后挂 TAGQ，最终就是 TAGQ 在前。
	for _ip in "$ipt" "$ipt6"; do
		hook_chain "$_ip" mangle PREROUTING "$TAGA"
		hook_chain "$_ip" mangle PREROUTING "$TAGQ"
	done
	build_quota_blocks
	apply_offload
	echo "$_tt" > "$STATE_DIR/daytype"
}

del_rule() {
	local _ip _ta _c
	for _ip in "$ipt" "$ipt6"; do
		for _ta in "$TAGQ" "$TAGA"; do
			$_ip -t mangle -D PREROUTING -j "$_ta" 2>/dev/null
			$_ip -t mangle -F "$_ta" 2>/dev/null
			$_ip -t mangle -X "$_ta" 2>/dev/null
		done
		# 老版本残留（统一模型之前）：filter 表的时间/协议链、mangle 表的网址/IP 链
		for _c in INPUT FORWARD OUTPUT; do
			for _ta in PARENTCONTROL_TIME PARENTCONTROL_PROTOCOL PARENTCONTROL_WEBURL; do
				$_ip -D "$_c" -j "$_ta" 2>/dev/null
			done
		done
		for _ta in PARENTCONTROL_TIME PARENTCONTROL_PROTOCOL; do
			$_ip -F "$_ta" 2>/dev/null
			$_ip -X "$_ta" 2>/dev/null
		done
		for _ta in PARENTCONTROL_WEBURL PARENTCONTROL_IP; do
			$_ip -t mangle -D PREROUTING -j "$_ta" 2>/dev/null
			$_ip -t mangle -F "$_ta" 2>/dev/null
			$_ip -t mangle -X "$_ta" 2>/dev/null
		done
	done
	clean_pca_chains
	restore_offload
}

prune_usage() {
	local _keep _cut
	_keep=$(pc_uget "@basic[0].usage_keep")
	case "$_keep" in ''|*[!0-9]*) _keep=90 ;; esac
	if [ "$_keep" -gt 0 ] 2>/dev/null; then
		find "$USAGE_DIR" -type f -mtime +"$_keep" -delete 2>/dev/null
		# 重置日志同样按保留天数裁剪（按行内日期过滤）；
		# date -d @epoch 若不被 busybox 支持，退化为按行数保留最近 2000 条（绝不“永不裁剪”）。
		if [ -f "$RESET_LOG" ]; then
			_cut=$(date -d "@$(( $(date +%s) - _keep * 86400 ))" +%Y-%m-%d 2>/dev/null)
			if [ -n "$_cut" ]; then
				awk -F'\t' -v cut="$_cut" '$1 >= cut' "$RESET_LOG" > "$RESET_LOG.new" 2>/dev/null && mv "$RESET_LOG.new" "$RESET_LOG"
			else
				tail -n 2000 "$RESET_LOG" > "$RESET_LOG.new" 2>/dev/null && mv "$RESET_LOG.new" "$RESET_LOG"
			fi
		fi
	fi
	return 0
}

# 用量看板数据：shell 只输出 TSV，Lua 侧再转 JSON
# （避免在 shell 里手拼 JSON 的转义问题）。行格式：
#   day    <日期> <school|holiday> <重置> <0|1已发放>
#   item   <条目> <已用分钟> <额度分钟,0=不限>
#   history <YYYYMMDD> <当天总分钟>

# 池成员（"module[idx]" 列表）
pool_members() { # $1=池名 $2=school|holiday
	local _m _i
	for _m in time protocol weburl; do
		for _i in $(pc_ids_on "$_m"); do
			[ "$(pc_entry_pool "$_m" "$_i" "$2")" = "$1" ] && echo "${_m}[${_i}]"
		done
	done
}

# 当前这一分钟内该条目产生的流量（KB）= 计数器当前值 - 上次采样基线
# 计数器 dump（v4+v6 一起），只让调用方 dump 一次再复用
dump_acct() { # $1=输出文件
	{
		$ipt -t mangle -nvx -L "$TAGA" 2>/dev/null
		$ipt6 -t mangle -nvx -L "$TAGA" 2>/dev/null
	} > "$1"
}

# 从 dump 文件里取某条目的累计字节数（$2 为空则现场 dump 一次）
acct_bytes() { # $1=key $2=dump文件
	local _f _v
	if [ -n "${2:-}" ]; then
		_f=$2
	else
		mkdir -p "$STATE_DIR"; _f="$STATE_DIR/acct.$$"; dump_acct "$_f"
	fi
	_v=$(awk -v t="PCA_$1" '$3==t{s+=$2} END{printf "%d", s+0}' "$_f")
	[ -n "${2:-}" ] || rm -f "$_f"
	echo "$_v"
}

# 当前这一分钟内该条目产生的流量（KB）= 计数器当前值 - 上次采样基线
quota_live_kb() { # $1=key $2=dump文件（空=现场 dump）
	local _v _b _d
	_v=$(acct_bytes "$1" "${2:-}")
	_b=0; [ -f "$STATE_DIR/base.$1" ] && _b=$(cat "$STATE_DIR/base.$1")
	_d=$(( _v - _b )); [ "$_d" -lt 0 ] && _d=$_v
	echo $(( _d / 1024 ))
}

# 清零一个条目的今日用量并把事件写进 $RESET_LOG（纯数据处理，不碰 iptables）。
# 回显重置前的已用分钟数。
reset_one() { # $1=key
	local _key _f _used
	_key="$1"
	_f=$(pc_usage_file)
	_used=$(pc_usage_get "$_key")
	mkdir -p "$(dirname "$RESET_LOG")"
	printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%d)" "$(date +%H:%M:%S)" "$_key" "$_used" >> "$RESET_LOG"
	# 抹掉今天的用量行（= 该条目今天已用清零）
	if [ -f "$_f" ]; then
		grep -v "^${_key} " "$_f" > "$_f.new" 2>/dev/null
		mv "$_f.new" "$_f"
	fi
	elog "reset_quota: $_key 重置（重置前已用 $_used 分钟）"
	echo "$_used"
}

# 重置某条目今天的额度（可对池：pool:<名字>；会记进 $RESET_LOG）
reset_quota() {
	local _arg _m _i _n _pname
	_arg="$1"
	[ -n "$_arg" ] || { elog "reset_quota: 缺参数"; return 1; }
	_n=0
	case "$_arg" in
	pool:*)
		_pname=${_arg#pool:}
		case "$_pname" in ''|*[!A-Za-z0-9_.-]*) elog "reset_quota: 非法池名"; return 1 ;; esac
		# 池：逐成员清数据，但只在最后重建一次封锁链（原先每个成员重建一次 = O(N²) 条 iptables）
		for _m in time protocol weburl; do
			for _i in $(pc_ids_on "$_m"); do
				[ "$(pc_entry_pool "$_m" "$_i" "$(pc_today_type)")" = "$_pname" ] || continue
				reset_one "${_m}_${_i}" >/dev/null
				_n=$((_n + 1))
			done
		done ;;
	*)
		# 严格白名单：只允许 module_index（防注入）
		case "$_arg" in *[!a-z0-9_]*) elog "reset_quota: 非法 key $_arg"; return 1 ;; esac
		reset_one "$_arg" >/dev/null
		_n=1 ;;
	esac
	# 若条目正被额度封锁，立刻重建封锁链让它马上可用。
	# 必须在 tick 锁内：否则可能与 tick 的 -F 交错，把「放行局域网」的规则整条冲掉，
	# 正好制造出自锁事故（还会持续到下一分钟）。
	[ "$_n" -gt 0 ] || return 0
	if pc_uget "@basic[0].enabled" | grep -q '^1$'; then
		with_tick_lock build_quota_blocks
	fi
	return 0
}

# 看板数据：结构化 TSV（Lua 侧解析并做分析、渲染）
#   meta     <日期> <school|holiday> <阈值KB> <保留天> <当前HH:MM>
#   entry    <key> <module> <idx> <备注> <mac> <模式> <额度> <已用> <池> <本分钟KB>
#   pool     <池名> <额度> <已用> <成员,逗号分隔>
#   hist     <YYYYMMDD> <当天总分钟>
#   histkey  <YYYYMMDD> <条目key> <分钟>
# 看板/列表数据：结构化 TSV（Lua 侧解析；不在 shell 里手拼 JSON）
#   stats_tsv brief  只输出 meta + entry（列表页够用，跳过历史/池/重置/计数器）
#   meta     <日期> <school|holiday> <阈值KB> <保留天> <当前HH:MM>
#   entry    <key> <module> <idx> <备注> <mac> <模式> <额度> <已用> <池> <本分钟KB>
#   pool     <池名> <额度> <已用> <成员,逗号分隔>
#   hist     <YYYYMMDD> <当天总分钟>
#   histkey  <YYYYMMDD> <条目key> <分钟>
stats_tsv() {
	local _brief _tt _min_kb _keep _m _i _key _mode _name _mac _q _u _pool _live _f _t _n _dump
	_brief="${1:-}"
	_tt=$(pc_today_type)
	_min_kb=$(pc_uget "@basic[0].usage_min_kb")
	case "$_min_kb" in ''|*[!0-9]*) _min_kb=8 ;; esac
	_keep=$(pc_uget "@basic[0].usage_keep")
	case "$_keep" in ''|*[!0-9]*) _keep=90 ;; esac
	printf 'meta\t%s\t%s\t%s\t%s\t%s\n' \
		"$(pc_today)" "$_tt" "$_min_kb" "$_keep" "$(date +%H:%M)"
	# 计数器 dump 只做一次：逐条目各起 2 个 iptables 会让弱路由器打开页面卡几秒
	if [ "$_brief" != "brief" ]; then
		mkdir -p "$STATE_DIR"; _dump="$STATE_DIR/acct.stats.$$"; dump_acct "$_dump"
	fi
	# 所有「已启用」条目（含时段模式，看板需要完整信息）
	for _m in time protocol weburl; do
		for _i in $(pc_ids_on "$_m"); do
			_mode=$(pc_entry_eff_mode "$_m" "$_i" "$_tt")
			_key="${_m}_${_i}"
			_name=$(pc_uget "@$_m[$_i].remarks" | tr -d '\t\r\n')
			_mac=$(pc_uget "@$_m[$_i].mac")
			_q=0; _u=0; _pool=""
			if [ "$_mode" = "quota" ]; then
				set -- $(entry_effective "$_m" "$_i" "$_tt")   # $1=额度 $2=已用 $3=池名
				_q=$1; _u=$2; _pool=${3:-}
			fi
			_live=0
			[ -z "$_dump" ] || _live=$(quota_live_kb "$_key" "$_dump")
			printf 'entry\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$_key" "$_m" "$_i" "$_name" "$_mac" "$_mode" "$_q" "$_u" "$_pool" "$_live"
		done
	done
	if [ "$_brief" != "brief" ]; then
		# 共享池
		for _i in $(pc_ids_all quota); do
			_n=$(pc_uget "@quota[$_i].name"); [ -n "$_n" ] || continue
			_q=$(pc_quota_positive "$(pc_pool_quota "$_n" "$_tt")")
			_u=$(pool_usage "$_n" "$_tt")
			printf 'pool\t%s\t%s\t%s\t%s\n' "$_n" "$_q" "$_u" \
				"$(pool_members "$_n" "$_tt" | tr '\n' ',' | sed 's/,$//')"
		done
		# 历史（最近 30 天）
		for _f in $(ls -1 "$USAGE_DIR" 2>/dev/null | tail -30); do
			_t=$(awk '{s+=$2} END{printf "%d", s+0}' "$USAGE_DIR/$_f" 2>/dev/null)
			printf 'hist\t%s\t%s\n' "$_f" "$_t"
			awk -v d="$_f" '{s[$1]+=$2} END{for(k in s) printf "histkey\t%s\t%s\t%d\n", d, k, s[k]}' "$USAGE_DIR/$_f" 2>/dev/null
		done
		# 重置记录：reset <YYYYMMDD> <HH:MM:SS> <key> <重置前已用分钟>
		# 只取最近 200 条事件，30 天窗口由 Lua 侧按日期过滤（shell 不做日期算术）。
		if [ -f "$RESET_LOG" ]; then
			tail -n 200 "$RESET_LOG" 2>/dev/null | awk -F'\t' 'NF >= 4 {gsub(/-/,"",$1); printf "reset\t%s\t%s\t%s\t%s\n", $1, $2, $3, $4}'
		fi
		[ -n "$_dump" ] && rm -f "$_dump"
	fi
	return 0
}

with_tick_lock() {
	mkdir "$TICK_LOCK" 2>/dev/null || {
		[ -n "$(find "$TICK_LOCK" -mmin +2 2>/dev/null)" ] || return 0
		rm -rf "$TICK_LOCK"
		mkdir "$TICK_LOCK" 2>/dev/null || return 0
	}
	"$@"
	rmdir "$TICK_LOCK" 2>/dev/null
	return 0
}

tick() { with_tick_lock tick_body; }

tick_body() {
	local _tt
	pc_uget "@basic[0].enabled" | grep -q '^1$' || return 0
	[ -n "$ipt" ] || return 0
	# 正在 start（重建全套规则）时跳过，避免并发
	[ -f "$LOCK" ] && return 0
	mkdir -p "$STATE_DIR"
	_tt=$(pc_today_type)
	if [ "$(cat "$STATE_DIR/daytype" 2>/dev/null)" != "$_tt" ]; then
		# 跨天 / 日子类型变化 → 生效档案变了，整套静态规则重建
		refresh_holiday
		refresh_ips
		build_all
	else
		sample_counters
		build_quota_blocks
	fi
}

refresh_ip() {
	pc_uget "@basic[0].enabled" | grep -q '^1$' || return 0
	[ -n "$ipt" ] || return 0
	with_tick_lock refresh_ip_body
}

# 只重建依赖 IP 解析结果的 mangle 链（网址时段/计数/额度封锁）。
# 注意：fw4 reload 会清掉这些链与 PREROUTING 跳转，所以必须 ensure/hook，
# 否则 cron 路径会静默失效（直到下次 restart 或跨天重建）。
rebuild_ip_rules() {
	local _tt _ip
	_tt=$(pc_today_type)
	for _ip in "$ipt" "$ipt6"; do
		ensure_chain "$_ip" mangle "$TAGA"
		ensure_chain "$_ip" mangle "$TAGQ"
		hook_chain "$_ip" mangle PREROUTING "$TAGA"
		hook_chain "$_ip" mangle PREROUTING "$TAGQ"
	done
	build_acct_rules "$_tt"
	build_quota_blocks
}

# cron 每 ip_refresh 分钟：采样后重解析域名、重建 IP 相关规则。
# 不重建 filter 表；refresh_holiday 自带节流（7 天/24h）、只写数据不建规则，
# 必须保留——长假期间 holiday→holiday 不触发跨天重建，否则节假日数据永不联网刷新。
refresh_ip_body() {
	refresh_holiday
	refresh_ips
	rebuild_ip_rules
}

cron_sync() { # $1=1 写入 / $1=0 移除
	local _mins new
	_mins=$(pc_uget "@basic[0].ip_refresh"); [ -z "$_mins" ] && _mins=30
	new=$(crontab -l 2>/dev/null | grep -v "$CRON_TAG" | grep -v "$CRON_TAG_IP")
	if [ "$1" = "1" ]; then
		new="$new
* * * * * /etc/init.d/parentcontrol tick >/dev/null 2>&1 $CRON_TAG"
		if [ "$_mins" -gt 0 ] 2>/dev/null; then
			new="$new
*/$_mins * * * * /etc/init.d/parentcontrol refresh_ip >/dev/null 2>&1 $CRON_TAG_IP"
		fi
	fi
	printf '%s\n' "$new" | grep -v '^$' | crontab -
	/etc/init.d/cron reload >/dev/null 2>&1
}

start() {
	[ -f "$LOCK" ] && {
		[ -n "$(find "$LOCK" -mmin +1 2>/dev/null)" ] || exit 1
		elog "removing stale lock $LOCK"
	}
	del_rule
	pc_uget "@basic[0].enabled" | grep -q '^1$' || exit 1
	[ -n "$ipt" ] || exit 1
	touch "$LOCK"
	trap 'rm -f "$LOCK"' EXIT INT TERM
	mkdir -p "$STATE_DIR" "$USAGE_DIR"
	refresh_holiday novet
	refresh_ips
	build_all
	cron_sync 1
	prune_usage
	clean_log
	rm -f "$LOCK" 2>/dev/null
}

stop() {
	del_rule
	cron_sync 0
	rm -f "$LOCK" 2>/dev/null
	rm -rf "$STATE_DIR" 2>/dev/null
}

reload() { stop; start; }
