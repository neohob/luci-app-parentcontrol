#!/bin/sh /etc/rc.common

DIR="$(cd "$(dirname "$0")" && pwd)"
MY_PATH=$DIR/iptables.sh
START=98

CONFIG=parentcontrol
LOG_FILE=/tmp/log/$CONFIG.log
LOCK_DIR=/tmp/lock
LOCK=/tmp/lock/${CONFIG}.lock
ipt=$(command -v iptables-legacy || command -v iptables)
ipt6=$(command -v ip6tables-legacy || command -v ip6tables)

TAG="PARENTCONTROL_TIME" 
TAGP="PARENTCONTROL_PROTOCOL" 
TAGW="PARENTCONTROL_WEBURL" 
FWI="/var/etc/$CONFIG.include"
elog() {
	local d="$(date "+%Y-%m-%d %H:%M:%S")"
	echo -e "$d: $*" >>$LOG_FILE
}

clean_log() {
	[ `cat $LOG_FILE  | wc -l ` -gt 500 ] && {
		elog "clear log ."
	}
}



# ============================================================================
# flow-offload 排除 —— 网址过滤能真正生效的前提
# ----------------------------------------------------------------------------
# 开启 flow offloading 的路由器，fw4 会往 forward 链装一条
#     meta l4proto { tcp, udp } flow add @ft
# 把「已建立的连接」丢进流卸载表。此后这条连接的报文在内核 ingress 快路径直接转发，
# 整个 netfilter 栈（包括 mangle PREROUTING）都不再经过。
#
# 后果：-m string 只能看到每条 TCP 连接的第一个 SYN，看不到握手之后那个真正带 SNI
# 的 ClientHello —— TCP 规则永远 0 命中。而 UDP 的 DNS 查询 / QUIC Initial 本身就是
# 「新流的首包」，必然经过 PREROUTING，所以只有 UDP 规则生效。
# 表现出来就是：DNS 和 HTTP/3 被拦住了，浏览器/App 一回落 TCP 就照常打开网站。
#
# 修法：给这条 flow add 加上 `ether saddr != <受管 MAC>` 条件，只把受管设备排除在
# 卸载之外。其它设备完全不受影响，也不绕过任何防火墙规则（比在 forward 链里直接
# return 安全 —— 那样会把后面的过滤规则一起跳过）。
# ============================================================================
offload_macs() {
	uci -q get $CONFIG.@basic[0].enabled | grep -q '^1$' || return 0
	uci show $CONFIG 2>/dev/null | grep "enable='1'" | grep 'weburl' \
		| grep -oE '\[[0-9]+\]' | tr -dc '0-9\n' \
		| while read i; do uci -q get $CONFIG.@weburl[$i].mac; done | sort -u
}

offload_handle() {
	nft -a list chain inet fw4 forward 2>/dev/null \
		| grep 'flow add @ft' | head -1 \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}

apply_offload() {
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	h=$(offload_handle)
	[ -z "$h" ] && return 0
	cond=""
	for m in $(offload_macs); do
		cond="$cond ether saddr != $m"
	done
	nft delete rule inet fw4 forward handle $h 2>/dev/null
	if [ -n "$cond" ]; then
		nft insert rule inet fw4 forward meta l4proto { tcp, udp }$cond flow add @ft 2>/dev/null \
			|| nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
		elog "offload: exclude$cond"
	else
		nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
	fi
}

# 停用功能时把 flow add 恢复成不带任何条件的样子，不留副作用。
restore_offload() {
	command -v nft >/dev/null 2>&1 || return 0
	nft list chain inet fw4 forward >/dev/null 2>&1 || return 0
	h=$(offload_handle)
	[ -z "$h" ] && return 0
	nft delete rule inet fw4 forward handle $h 2>/dev/null
	nft insert rule inet fw4 forward meta l4proto { tcp, udp } flow add @ft 2>/dev/null
	elog "offload: restored"
}

set_rules() {
mmode=$1
   case $mmode in
    time)
	  controlmode=`uci -q get $CONFIG.@basic[0].control_mode`
	  [ "x$controlmode" == 'x1' ] && chains="INPUT FORWARD" || chains="FORWARD"
          for ip in "$ipt" "$ipt6" ; do
                  $ip -N $TAG 2>/dev/null || $ip -F $TAG 2>/dev/null 
                  for chain in $chains; do
                    $ip -C $chain -j  $TAG 2>/dev/null ||  $ip -I $chain -j  $TAG 2>/dev/null
                  done
	  done
    ;;
    protocol)
       chain=FORWARD
       for ip in "$ipt" "$ipt6" ; do
                  $ip -N $TAGP 2>/dev/null || $ip -F $TAGP 2>/dev/null 
                  $ip -C $chain -j  $TAGP 2>/dev/null ||  $ip -I $chain -j  $TAGP 2>/dev/null
      done
    
    ;;
    weburl)
      # 原版把网址过滤挂在 OUTPUT 链上，但 `-m mac --mac-source` 在 OUTPUT 里永远不成立
      # （路由器本机发出的报文没有源 MAC），所以「按 MAC 限制某台设备访问某个网址」
      # 从来就没生效过 —— 界面显示正常、iptables 也不报错，纯粹静默失效。
      #
      # 改挂 mangle 表的 PREROUTING：只有这个位置同时满足三个条件 ——
      #   1. 还看得到客户端的源 MAC；
      #   2. 报文负载还是明文（TLS ClientHello 里的 SNI、明文 DNS 查询里的域名）；
      #   3. 位于 flowtable 快转决策之前、也位于其它组件改写目的地址之前。
      # 挂在 filter 的 INPUT/FORWARD 上时，连接一建立就被卸载，后续报文根本到不了规则。
      algos=`uci -q get $CONFIG.@basic[0].algos` 
      for ip in "$ipt" "$ipt6" ; do
                  $ip -t mangle -N $TAGW 2>/dev/null || $ip -t mangle -F $TAGW 2>/dev/null
                  $ip -t mangle -C PREROUTING -j $TAGW 2>/dev/null || $ip -t mangle -I PREROUTING -j $TAGW 2>/dev/null
      done
      apply_offload
    
    ;;
esac  
idlist=`uci show $CONFIG | grep "enable='1'" | grep "$mmode" | grep -oE '\[.*?\]' | grep -o '[0-9]'`
for i in $idlist ;do
    mac=$(uci -q get $CONFIG.@$mmode[$i].mac ) && MAC="-m mac --mac-source $mac" || MAC=""
    timestart=$(uci -q get $CONFIG.@$mmode[$i].timestart ) || timestart="00:00"
    timeend=$(uci -q get $CONFIG.@$mmode[$i].timeend) ||  timeend="00:00"
    wweek=$(uci -q get $CONFIG.@$mmode[$i].week )  || wweek='*'
    # ash 不支持 `local a=1,b=2` 这种写法，会报 "bad variable name" 并中止整个脚本，
    # 导致 time 之后再也没设置 protocol/weburl 两组规则，还留下一个锁文件。
    local Z1 Z2 Z3 Z4 Z5 Z6 Z7
    for ww in `echo $wweek | sed 's/,/ /g' `; do 
        [ "$ww" == "1" ] && Z1="Mon,"
        [ "$ww" == "2" ] && Z2="Tue,"
        [ "$ww" == "3" ] && Z3="Wed," 
        [ "$ww" == "4" ] && Z4="Thu," 
        [ "$ww" == "5" ] && Z5="Fri,"
        [ "$ww" == "6" ] && Z6="Sat," 
        [ "$ww" == "7" ] && Z7="Sun"
    done
    [ -z "$timestart" -o -z "$timeend" -o "$timestart" = "$timeend" ] && TIME="" || TIME="--timestart ${timestart} --timestop ${timeend}"
    [ -z "$wweek" -o "x$wweek" = "x*" ] && WEEK="" || WEEK="--weekdays $Z1$Z2$Z3$Z4$Z5$Z6$Z7"
    [ -n "$TIME" -o -n "$WEEK" ] && WT="-m time --kerneltz ${TIME} ${WEEK}" || WT=""
   case $mmode in
    time)
          for pt in "$ipt" "$ipt6" ; do
		$pt -I $TAG ${MAC} ${WT} -j REJECT 2>/dev/null 
		elog "$mmode:$pt -- ${MAC} -- ${WT}  "
	done
    ;;
    protocol)
        proto=$(uci -q get $CONFIG.@$mmode[$i].proto ) || proto="tcp"
	ports=$(uci -q get $CONFIG.@$mmode[$i].ports ) && SPO="--sport ${ports}" || SPO=""
	portd=$(uci -q get $CONFIG.@$mmode[$i].portd ) && DPO="--dport ${portd}" || DPO=""
	mMPT=`echo "$ports"|grep ","` && mSPO="-m multiport" || mSPO=""
	mMPT=`echo "$portd"|grep ","` && mDPO="-m multiport" || mDPO=""
	[ -z "$ports" -a -z "$portd" ] && PTO="" || PTO="-p ${proto} ${mSPO} ${SPO} ${mDPO} ${DPO}"
        for pt in "$ipt" "$ipt6" ; do
		$pt -I $TAGP ${MAC} ${WT} ${PTO} -j REJECT 2>/dev/null 
		elog "$mmode: $pt -- ${MAC} -- ${WT} -- ${PTO}"
	done
    ;;
    weburl)
	# 原版只封了 UDP 53(DNS) 和 TCP 853(DoT)，且 853 那两条带着永远非法的
	# `--hex-string`（word 是明文关键词、不是十六进制），等于实际只挡了 DNS —— 而
	# 浏览器/App 用缓存的 IP 走 443 就完全绕过去了。
	# 现在按明文关键词同时封 UDP 和 TCP：UDP 命中明文 DNS 查询，TCP 命中 TLS
	# ClientHello 的 SNI。mangle 表不认 REJECT，只能用 DROP。
	word=$(uci -q get $CONFIG.@$mmode[$i].word ) && STR="-m string --algo ${algos} --string ${word}" || STR=""
          for pt in "$ipt" "$ipt6" ; do
		$pt -t mangle -I $TAGW -p UDP ${MAC} ${WT} ${STR} -j DROP 2>/dev/null
		$pt -t mangle -I $TAGW -p TCP ${MAC} ${WT} ${STR} -j DROP 2>/dev/null
		elog "$mmode: $pt -- ${MAC} -- ${WT} -- ${STR}"
	  done
    ;; 
    *) ;;
   esac
   unset STR MAC WT PTO
done
}

flush_include() {
	echo '#!/bin/sh' >$FWI
}

del_rule() {
  for ip in "$ipt" "$ipt6" ; do
      for ta in "$TAG" "$TAGW" "$TAGP" ; do
	 for chain in "PREROUTING" "FORWARD" "OUTPUT" "INPUT" ; do
	     	$ip -D  $chain -j $ta 2>/dev/null
		
		# elog "delrule: $ip -- $ta -- ${chain} "
	 done
	 $ip -F $ta 2>/dev/null
	 $ip -X $ta 2>/dev/null
      done
      # mangle 表里还有一条同名链（不同表），必须单独清，否则关掉功能后
      # PREROUTING 上会残留一条永远匹配不上的跳转。
      $ip -t mangle -D PREROUTING -j $TAGW 2>/dev/null
      $ip -t mangle -F $TAGW 2>/dev/null
      $ip -t mangle -X $TAGW 2>/dev/null
  done
  restore_offload
}

start(){
     # 脚本被中断时锁文件会残留，之后每次 start() 都直接 exit 1（界面显示未运行、
     # 也不报任何错）。超过一分钟的锁视为陈旧锁，清掉继续。
     [ -f $LOCK ] && {
        [ -n "$(find $LOCK -mmin +1 2>/dev/null)" ] || exit 1
        elog "removing stale lock $LOCK"
     }
     del_rule
     enabled=`uci -q get $CONFIG.@basic[0].enabled`
     [ "x$enabled" == "x1" ] || exit 1
     allsum=`grep -c 'enable .1.' /etc/config/$CONFIG`
     [ "$allsum" -gt 0 ] && {
        touch $LOCK
        set_rules time
	set_rules protocol
	set_rules weburl
    }
     clean_log 
     rm -f $LOCK  2>/dev/null
}

stop(){
     del_rule
     rm -f $LOCK  2>/dev/null
}


