config basic
	option algos 'kmp'
	option enabled '0'
	option ip_refresh '30'
	option ip_mask '24'
	# 用量历史保留天数
	option usage_keep '90'
	# 一分钟内至少多少 KB 才算“在用”（滤掉后台心跳），0=任何流量都算
	option usage_min_kb '8'

config weburl
	option remarks 'Example'
	option enable '0'
	option domains 'example.com'
	# 绑定设备行表（1.8.7 起）：一行一台设备，格式 <MAC>|<IP>，两侧都可留空
	# （只有 MAC / 只有 IP 也合法）。同一条目的多台设备共用这一条的额度与时段；
	# 行序即规则次序。老的 mac/ip 两个字段由首次启动的迁移并成第一行后删除
	# （迁移幂等：已迁移的条目一个字段都不会再动）。例：
	#	option clients '00:11:22:33:44:55|192.168.1.10
	#	66:77:88:99:aa:bb'
	# 每个档案 = 可用时段 + 额度：时段外一律不可用且不计入额度；额度 0 = 一分钟都不给；
	# unlimited=1 = 只判时段（配合时段全天 = 完全不限制）
	# 时段不跨日（起必须早于止），00:00:00-23:59:59 = 全天
	option sd_quota '60'
	option sd_qstart '09:00:00'
	option sd_qend '21:00:00'
	option sd_unlimited '0'
	option hd_quota '120'
	option hd_qstart '09:00:00'
	option hd_qend '21:00:00'
	option hd_unlimited '0'

config protocol
	option proto 'tcp'
	option portd '80'
	option enable '0'
	option sd_quota '60'
	option sd_qstart '00:00:00'
	option sd_qend '23:59:59'
	option sd_unlimited '0'

config time
	option enable '0'
	option sd_quota '60'
	option sd_qstart '09:00:00'
	option sd_qend '21:00:00'
	option sd_unlimited '0'
	option hd_qstart '09:00:00'
	option hd_qend '21:00:00'
	option hd_unlimited '1'

# 共享额度池：条目在档案里填池名即可并入，组内流量加总、共用额度
config quota
	option name 'kid1'
	option sd_quota '60'
	option hd_quota '120'

# 寒暑假区间：MM-DD 表示每年重复（如暑假），YYYY-MM-DD 表示绝对年份（如寒假）
config vacation
	option name 'summer'
	option start '07-01'
	option end '08-31'

# AI 辅助解析（可选）：endpoint 为 OpenAI 兼容接口基址（如 http://192.168.1.10:11434/v1），
# model 为模型 id，apikey 可留空。仅用于「编辑条目」页的「AI 解析」按钮。
config ai 'ai'
	option endpoint ''
	option model ''
	option apikey ''
