config basic
	option algos 'kmp'
	option enabled '0'
	option ip_refresh '30'
	option ip_mask '24'
	# 用量历史保留天数
	option usage_keep '90'
	# 一分钟内至少多少 KB 才算“在用”（滤掉后台心跳），0=任何流量都算
	option usage_min_kb '8'

config weburl
	option remarks 'Example'
	option enable '0'
	option domains 'example.com'
	# 每个档案 = 可用时段 + 额度：时段外一律不可用且不计入额度；额度 0 = 一分钟都不给；
	# unlimited=1 = 只判时段（配合时段全天 = 完全不限制）
	# 时段不跨日（起必须早于止），00:00:00-23:59:59 = 全天
	option sd_quota '60'
	option sd_qstart '09:00:00'
	option sd_qend '21:00:00'
	option sd_unlimited '0'
	option hd_quota '120'
	option hd_qstart '09:00:00'
	option hd_qend '21:00:00'
	option hd_unlimited '0'

config protocol
	option proto 'tcp'
	option portd '80'
	option enable '0'
	option sd_quota '60'
	option sd_qstart '00:00:00'
	option sd_qend '23:59:59'
	option sd_unlimited '0'

config time
	option enable '0'
	option sd_quota '60'
	option sd_qstart '09:00:00'
	option sd_qend '21:00:00'
	option sd_unlimited '0'
	option hd_qstart '09:00:00'
	option hd_qend '21:00:00'
	option hd_unlimited '1'

# 共享额度池：条目在额度模式里填池名即可并入，组内流量加总、共用额度
config quota
	option name 'kid1'
	option sd_quota '60'
	option hd_quota '120'

# 寒暑假区间：MM-DD 表示每年重复（如暑假），YYYY-MM-DD 表示绝对年份（如寒假）
config vacation
	option name 'summer'
	option start '07-01'
	option end '08-31'
